<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:String x:Key="AppTitle">Claude Code 启动器</sys:String>
    <sys:String x:Key="AppSubtitle">在 Claude Code 中打开文件夹，或解决安装问题。</sys:String>
    <sys:String x:Key="LanguageLabel">显示语言</sys:String>
    <sys:String x:Key="OpenFolderTitle">打开文件夹</sys:String>
    <sys:String x:Key="OpenFolderBody">输入完整路径，或浏览并选择本机上的文件夹。</sys:String>
    <sys:String x:Key="FolderLabel">项目文件夹</sys:String>
    <sys:String x:Key="BrowseFolder">浏览…</sys:String>
    <sys:String x:Key="OpenFolder">开始新会话</sys:String>
    <sys:String x:Key="RecentTitle">最近使用的文件夹</sys:String>
    <sys:String x:Key="HistoryLoading">正在读取最近使用的文件夹…</sys:String>
    <sys:String x:Key="HistoryEmpty">在 Claude Code 中打开过的文件夹会显示在这里。</sys:String>
    <sys:String x:Key="HistoryUnavailable">无法读取最近使用的文件夹。请输入路径或浏览选择。</sys:String>
    <sys:String x:Key="SetupTitle">安装和修复</sys:String>
    <sys:String x:Key="SetupBody">首次安装 Claude Code 或无法启动时，请先检查这台电脑。</sys:String>
    <sys:String x:Key="CheckSetup">检查安装状态</sys:String>
    <sys:String x:Key="CheckAgain">重新检查</sys:String>
    <sys:String x:Key="CheckAfterLogin">登录后重新检查</sys:String>
    <sys:String x:Key="CheckLoginAndOpen">确认登录并在此处打开</sys:String>
    <sys:String x:Key="TargetFolder">所选文件夹</sys:String>
    <sys:String x:Key="ResultDetailLabel">详细信息</sys:String>
    <sys:String x:Key="CopyLoginCommand">复制登录命令</sys:String>
    <sys:String x:Key="CopySummary">复制诊断摘要</sys:String>
    <sys:String x:Key="OfficialHelp">官方帮助</sys:String>
    <sys:String x:Key="Install">安装 Claude Code</sys:String>
    <sys:String x:Key="InstallAndOpen">安装并在此处打开</sys:String>
    <sys:String x:Key="RepairPath">添加到用户 PATH</sys:String>
    <sys:String x:Key="RepairPathAndOpen">修复 PATH 并在此处打开</sys:String>
    <sys:String x:Key="RefreshPath">刷新 PATH</sys:String>
    <sys:String x:Key="RefreshPathAndOpen">刷新 PATH 并在此处打开</sys:String>
    <sys:String x:Key="ReadyTitle">Claude Code 已就绪</sys:String>
    <sys:String x:Key="ReadyBody">打开一个文件夹即可开始使用 Claude Code。</sys:String>
    <sys:String x:Key="MissingTitle">未找到 Claude Code</sys:String>
    <sys:String x:Key="MissingBody">可以使用 WinGet 的官方软件包（Anthropic.ClaudeCode）为当前 Windows 帐户安装 Claude Code。</sys:String>
    <sys:String x:Key="PathMissingTitle">PATH 中缺少 Claude Code 的路径</sys:String>
    <sys:String x:Key="PathMissingBody">可执行文件可以直接运行。将下方文件夹添加到用户 PATH 后，PowerShell 就能找到 claude 命令。</sys:String>
    <sys:String x:Key="StalePathTitle">启动器正在使用旧的 PATH</sys:String>
    <sys:String x:Key="StalePathBody">Windows 已记录 Claude Code 的路径。刷新后，启动器及其打开的 PowerShell 将使用最新的路径。</sys:String>
    <sys:String x:Key="AuthRequiredTitle">需要登录 Claude Code</sys:String>
    <sys:String x:Key="AuthRequiredBody">在 PowerShell 中运行 claude auth login，也可以按已打开的 Claude Code 会话中的提示登录。登录后回到这里重新检查。</sys:String>
    <sys:String x:Key="ConflictTitle">PowerShell 可能找到了其他命令</sys:String>
    <sys:String x:Key="ConflictBody">在 PowerShell 中运行 Get-Command claude -All，查看是否存在其他安装、别名或函数。</sys:String>
    <sys:String x:Key="UnknownTitle">暂时无法确定原因</sys:String>
    <sys:String x:Key="UnknownBody">在 PowerShell 中试运行 claude --version，再回到这里重新检查。如果 Windows 阻止运行，请联系电脑管理员。</sys:String>
    <sys:String x:Key="InvalidFolderTitle">请选择可访问的文件夹</sys:String>
    <sys:String x:Key="InvalidFolderBody">请检查完整路径，或通过“浏览”选择其他文件夹。</sys:String>
    <sys:String x:Key="RepairFailedTitle">安装或修复未完成</sys:String>
    <sys:String x:Key="RepairFailedBody">请重新检查当前状态。如果无法使用 WinGet 或它被阻止，请查看官方安装说明。</sys:String>
    <sys:String x:Key="LaunchFailedTitle">无法启动 Claude Code</sys:String>
    <sys:String x:Key="LaunchFailedBody">已通过安装检查。请在此文件夹中打开 PowerShell 并运行 claude，查看终端中的消息。</sys:String>
    <sys:String x:Key="RetryFailedTitle">重试后仍无法启动 Claude Code</sys:String>
    <sys:String x:Key="RetryFailedBody">请重新检查安装状态，或在此文件夹中打开 PowerShell 查看错误。</sys:String>
    <sys:String x:Key="ExitCode">退出代码 {0}</sys:String>
    <sys:String x:Key="Checking">正在检查 Claude Code 安装状态…</sys:String>
    <sys:String x:Key="Installing">正在通过 WinGet 安装 Claude Code…</sys:String>
    <sys:String x:Key="Repairing">正在更新 PATH…</sys:String>
    <sys:String x:Key="Verifying">正在验证当前安装状态…</sys:String>
    <sys:String x:Key="TerminalPending">PowerShell 正在打开或使用中。</sys:String>
    <sys:String x:Key="TerminalExited">Claude Code 会话已结束。</sys:String>
    <sys:String x:Key="TerminalCanceled">终端会话已取消。</sys:String>
    <sys:String x:Key="TerminalUnknown">启动器无法确认终端会话是如何结束的。</sys:String>
    <sys:String x:Key="TerminalFailed">终端报告了启动问题。</sys:String>
    <sys:String x:Key="LoginCopied">已复制登录命令。</sys:String>
    <sys:String x:Key="SummaryCopied">已复制诊断摘要。</sys:String>
    <sys:String x:Key="CopyFailed">无法复制到剪贴板，请重试。</sys:String>
    <sys:String x:Key="HelpFailed">无法打开浏览器。</sys:String>
    <sys:String x:Key="LanguageSaveFailed">显示语言已更改，但无法保存设置。</sys:String>
    <sys:String x:Key="SessionsTitle">最近会话</sys:String>
    <sys:String x:Key="SessionsLoading">正在读取最近会话…</sys:String>
    <sys:String x:Key="SessionsEmpty">还没有已保存的会话。</sys:String>
    <sys:String x:Key="SessionsEmptyFolder">此文件夹没有已保存的会话。</sys:String>
    <sys:String x:Key="SessionScopeFolder">当前文件夹</sys:String>
    <sys:String x:Key="SessionScopeAll">所有文件夹</sys:String>
    <sys:String x:Key="ShowAllSessions">查看全部</sys:String>
    <sys:String x:Key="ShowFolderSessions">仅查看此文件夹</sys:String>
    <sys:String x:Key="SessionsPartial">部分会话无法读取。可以使用 CLI 选择器查找某个文件夹中的会话。</sys:String>
    <sys:String x:Key="SessionResumeUnavailable">可以使用 CLI 选择器在此文件夹中查找会话。</sys:String>
    <sys:String x:Key="SessionPicker">在 CLI 中选择会话</sys:String>
    <sys:String x:Key="SessionFallbackRunning">正在所选文件夹中打开 CLI 会话选择器…</sys:String>
    <sys:String x:Key="ResumeIntent">继续所选会话</sys:String>
    <sys:String x:Key="PickerIntent">打开 CLI 会话选择器</sys:String>
    <sys:String x:Key="CliExitedWithErrorTitle">Claude Code 因错误退出</sys:String>
    <sys:String x:Key="CliExitedWithErrorBody">可以重新检查安装状态，或查看 PowerShell 中显示的消息。</sys:String>
    <sys:String x:Key="EvidenceRepairLockUnavailable">无法锁定此 Windows 帐户的安装变更。</sys:String>
    <sys:String x:Key="EvidenceRepairInProgress">另一个启动器窗口正在更改安装设置。</sys:String>
    <sys:String x:Key="EvidenceAccessDenied">Windows 拒绝了访问。</sys:String>
    <sys:String x:Key="EvidenceEnvironmentCheckFailed">无法检查 PowerShell 环境。</sys:String>
    <sys:String x:Key="EvidenceCommandLookupFailed">PowerShell 无法查询 claude 命令。</sys:String>
    <sys:String x:Key="EvidenceUnsupportedCommandType">PowerShell 找到了不受支持的命令类型。</sys:String>
    <sys:String x:Key="EvidenceSignatureCheckFailed">无法检查可执行文件的签名。</sys:String>
    <sys:String x:Key="EvidenceSignatureUnverified">未能验证可执行文件的签名。</sys:String>
    <sys:String x:Key="EvidenceVersionCheckFailed">未能确认 CLI 版本。</sys:String>
    <sys:String x:Key="EvidenceAuthStatusUnverified">未能确认 CLI 登录状态。</sys:String>
    <sys:String x:Key="EvidencePathEntryUnsupported">启动器无法将此文件夹添加到 PATH。</sys:String>
    <sys:String x:Key="EvidencePathTargetChanged">PowerShell 在另一个文件夹中找到了该命令。</sys:String>
    <sys:String x:Key="EvidenceUserPathChanged">修复期间，已保存的用户 PATH 发生了变化。请重新检查后再试。</sys:String>
    <sys:String x:Key="EvidencePathVerificationFailed">更新 PATH 后仍未能确认命令。</sys:String>
    <sys:String x:Key="EvidenceWinGetUnavailable">未在预期位置找到 WinGet。</sys:String>
    <sys:String x:Key="EvidenceWinGetStartFailed">无法启动 WinGet。</sys:String>
    <sys:String x:Key="EvidenceWinGetTimeoutTerminationUnverified">WinGet 未在规定时间内完成。重试前请确认它是否仍在运行。</sys:String>
    <sys:String x:Key="EvidenceWinGetTimeout">WinGet 未在规定时间内完成。重试前请重新检查安装状态。</sys:String>
    <sys:String x:Key="EvidenceWinGetVerificationFailed">WinGet 已运行完毕，但启动器仍未找到 Claude Code。</sys:String>
    <sys:String x:Key="EvidenceWinGetPackageConsentRequired">请在 PowerShell 中运行下方命令并查看软件包协议。</sys:String>
    <sys:String x:Key="EvidenceWinGetSourceConsentRequired">请在 PowerShell 中运行下方命令并查看 WinGet 源协议。</sys:String>
    <sys:String x:Key="EvidenceWinGetInstallFailed">WinGet 报告了安装错误。</sys:String>
    <sys:String x:Key="SessionsPartialWithFolders">部分会话无法读取。选择下方文件夹，即可在 CLI 中查看其中的会话。</sys:String>
    <sys:String x:Key="EvidenceWinGetAlreadyRunning">当前 Windows 会话中已有 WinGet 在运行。请等待其结束，然后重新检查。</sys:String>
    <sys:String x:Key="EvidenceWorkingFolderUnavailable">PowerShell 无法打开所选文件夹。</sys:String>
    <sys:String x:Key="EvidenceInstallationFootprintFound">找到了以前安装留下的文件或注册信息。启动器未能确认 Claude Code 能否运行。</sys:String>
    <sys:String x:Key="EvidencePowerShellStartFailed">无法启动 PowerShell 进行检查。</sys:String>
    <sys:String x:Key="EvidencePowerShellTimeout">PowerShell 检查超时。</sys:String>
    <sys:String x:Key="EvidencePowerShellExitFailed">PowerShell 在检查期间因错误退出。</sys:String>
    <sys:String x:Key="EvidencePowerShellOutputInvalid">启动器无法解析 PowerShell 的检查结果。</sys:String>
    <sys:String x:Key="EvidencePowerShellProbeFailed">PowerShell 检查未能完成。</sys:String>
</ResourceDictionary>
