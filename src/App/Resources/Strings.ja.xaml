<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:String x:Key="AppTitle">Claude Code ランチャー</sys:String>
    <sys:String x:Key="AppSubtitle">Claude Code でフォルダーを開いたり、セットアップの問題を解決したりできます。</sys:String>
    <sys:String x:Key="LanguageLabel">表示言語</sys:String>
    <sys:String x:Key="OpenFolderTitle">フォルダーを開く</sys:String>
    <sys:String x:Key="OpenFolderBody">フォルダーのフルパスを入力するか、参照から選択してください。</sys:String>
    <sys:String x:Key="FolderLabel">作業フォルダー</sys:String>
    <sys:String x:Key="BrowseFolder">参照…</sys:String>
    <sys:String x:Key="OpenFolder">新しい会話を開く</sys:String>
    <sys:String x:Key="RecentTitle">最近使ったフォルダー</sys:String>
    <sys:String x:Key="HistoryLoading">最近使ったフォルダーを読み込んでいます…</sys:String>
    <sys:String x:Key="HistoryEmpty">Claude Code で開いた作業フォルダーがここに表示されます。</sys:String>
    <sys:String x:Key="HistoryUnavailable">最近使ったフォルダーを読み込めませんでした。パスを入力するか、参照から選択してください。</sys:String>
    <sys:String x:Key="SetupTitle">セットアップと修復</sys:String>
    <sys:String x:Key="SetupBody">Claude Code を初めてインストールするときや起動できないときに、この PC を確認してください。</sys:String>
    <sys:String x:Key="CheckSetup">セットアップを確認</sys:String>
    <sys:String x:Key="CheckAgain">再確認</sys:String>
    <sys:String x:Key="CheckAfterLogin">ログイン後に再確認</sys:String>
    <sys:String x:Key="CheckLoginAndOpen">ログインを確認してここで開く</sys:String>
    <sys:String x:Key="TargetFolder">選択したフォルダー</sys:String>
    <sys:String x:Key="ResultDetailLabel">詳細</sys:String>
    <sys:String x:Key="CopyLoginCommand">ログインコマンドをコピー</sys:String>
    <sys:String x:Key="CopySummary">診断結果をコピー</sys:String>
    <sys:String x:Key="OfficialHelp">公式ヘルプ</sys:String>
    <sys:String x:Key="Install">Claude Code をインストール</sys:String>
    <sys:String x:Key="InstallAndOpen">インストールしてここで開く</sys:String>
    <sys:String x:Key="RepairPath">ユーザー PATH に追加</sys:String>
    <sys:String x:Key="RepairPathAndOpen">PATH を修復してここで開く</sys:String>
    <sys:String x:Key="RefreshPath">PATH を読み直す</sys:String>
    <sys:String x:Key="RefreshPathAndOpen">PATH を読み直してここで開く</sys:String>
    <sys:String x:Key="ReadyTitle">Claude Code を開けます</sys:String>
    <sys:String x:Key="ReadyBody">作業フォルダーを開いて Claude Code を起動してください。</sys:String>
    <sys:String x:Key="MissingTitle">Claude Code が見つかりません</sys:String>
    <sys:String x:Key="MissingBody">WinGet の公式パッケージ（Anthropic.ClaudeCode）を現在の Windows アカウントにインストールできます。</sys:String>
    <sys:String x:Key="PathMissingTitle">PATH に Claude Code のパスがありません</sys:String>
    <sys:String x:Key="PathMissingBody">実行ファイルは直接起動できます。以下のフォルダーをユーザー PATH に追加すると、PowerShell で claude コマンドが見つかります。</sys:String>
    <sys:String x:Key="StalePathTitle">ランチャーが古い PATH を使っています</sys:String>
    <sys:String x:Key="StalePathBody">Claude Code のパスは Windows に登録済みです。ランチャーと、ここから開く PowerShell に最新のパスを反映します。</sys:String>
    <sys:String x:Key="AuthRequiredTitle">Claude Code へのログインが必要です</sys:String>
    <sys:String x:Key="AuthRequiredBody">PowerShell で claude auth login を実行するか、起動中の Claude Code の案内に従ってログインしてください。完了したらここで再確認してください。</sys:String>
    <sys:String x:Key="ConflictTitle">PowerShell が別のコマンドを参照している可能性があります</sys:String>
    <sys:String x:Key="ConflictBody">PowerShell で Get-Command claude -All を実行すると、別のインストール、エイリアス、関数が見つかっていないか確認できます。</sys:String>
    <sys:String x:Key="UnknownTitle">原因を特定できませんでした</sys:String>
    <sys:String x:Key="UnknownBody">PowerShell で claude --version を実行してから、ここで再確認してください。Windows が実行をブロックする場合は PC の管理者にご相談ください。</sys:String>
    <sys:String x:Key="InvalidFolderTitle">アクセスできるフォルダーを選択してください</sys:String>
    <sys:String x:Key="InvalidFolderBody">フルパスを確認するか、参照から別のフォルダーを選択してください。</sys:String>
    <sys:String x:Key="RepairFailedTitle">インストールまたは修復を完了できませんでした</sys:String>
    <sys:String x:Key="RepairFailedBody">現在の状態を再確認してください。WinGet を使えない場合や実行がブロックされる場合は、公式のインストール手順をご確認ください。</sys:String>
    <sys:String x:Key="LaunchFailedTitle">Claude Code を起動できませんでした</sys:String>
    <sys:String x:Key="LaunchFailedBody">セットアップの確認は通りました。このフォルダーで PowerShell を開き、claude を実行してターミナルのメッセージをご確認ください。</sys:String>
    <sys:String x:Key="RetryFailedTitle">再試行しても Claude Code を起動できませんでした</sys:String>
    <sys:String x:Key="RetryFailedBody">現在のセットアップを再確認するか、このフォルダーで PowerShell を開いてエラーをご確認ください。</sys:String>
    <sys:String x:Key="ExitCode">終了コード {0}</sys:String>
    <sys:String x:Key="Checking">Claude Code のセットアップを確認しています…</sys:String>
    <sys:String x:Key="Installing">WinGet で Claude Code をインストールしています…</sys:String>
    <sys:String x:Key="Repairing">PATH を更新しています…</sys:String>
    <sys:String x:Key="Verifying">現在のセットアップを検証しています…</sys:String>
    <sys:String x:Key="TerminalPending">PowerShell を開いているか、使用中です。</sys:String>
    <sys:String x:Key="TerminalExited">Claude Code セッションが終了しました。</sys:String>
    <sys:String x:Key="TerminalCanceled">ターミナルセッションをキャンセルしました。</sys:String>
    <sys:String x:Key="TerminalUnknown">ターミナルセッションの終了状態を確認できませんでした。</sys:String>
    <sys:String x:Key="TerminalFailed">ターミナルで起動時の問題が発生しました。</sys:String>
    <sys:String x:Key="LoginCopied">ログインコマンドをコピーしました。</sys:String>
    <sys:String x:Key="SummaryCopied">診断結果をコピーしました。</sys:String>
    <sys:String x:Key="CopyFailed">クリップボードにコピーできませんでした。もう一度お試しください。</sys:String>
    <sys:String x:Key="HelpFailed">ブラウザーを開けませんでした。</sys:String>
    <sys:String x:Key="LanguageSaveFailed">表示言語は変わりましたが、設定を保存できませんでした。</sys:String>
    <sys:String x:Key="SessionsTitle">最近の会話</sys:String>
    <sys:String x:Key="SessionsLoading">最近の会話を読み込んでいます…</sys:String>
    <sys:String x:Key="SessionsEmpty">保存済みの会話はまだありません。</sys:String>
    <sys:String x:Key="SessionsEmptyFolder">このフォルダーに保存済みの会話はありません。</sys:String>
    <sys:String x:Key="SessionScopeFolder">このフォルダー</sys:String>
    <sys:String x:Key="SessionScopeAll">すべてのフォルダー</sys:String>
    <sys:String x:Key="ShowAllSessions">すべて表示</sys:String>
    <sys:String x:Key="ShowFolderSessions">このフォルダーだけ表示</sys:String>
    <sys:String x:Key="SessionsPartial">一部の会話を読み込めませんでした。CLI の一覧から、フォルダー内の会話を探せます。</sys:String>
    <sys:String x:Key="SessionResumeUnavailable">CLI の一覧から、このフォルダー内の会話を探せます。</sys:String>
    <sys:String x:Key="SessionPicker">CLI で会話を選ぶ</sys:String>
    <sys:String x:Key="SessionFallbackRunning">選択したフォルダーで CLI の会話一覧を開いています…</sys:String>
    <sys:String x:Key="ResumeIntent">選択した会話を再開</sys:String>
    <sys:String x:Key="PickerIntent">CLI の会話一覧を開く</sys:String>
    <sys:String x:Key="CliExitedWithErrorTitle">Claude Code がエラーで終了しました</sys:String>
    <sys:String x:Key="CliExitedWithErrorBody">セットアップを再確認するか、PowerShell に表示されたメッセージをご確認ください。</sys:String>
    <sys:String x:Key="EvidenceRepairLockUnavailable">この Windows アカウントのセットアップ変更をロックできませんでした。</sys:String>
    <sys:String x:Key="EvidenceRepairInProgress">別のランチャーウィンドウでセットアップを変更しています。</sys:String>
    <sys:String x:Key="EvidenceAccessDenied">Windows によってアクセスが拒否されました。</sys:String>
    <sys:String x:Key="EvidenceEnvironmentCheckFailed">PowerShell の環境を確認できませんでした。</sys:String>
    <sys:String x:Key="EvidenceCommandLookupFailed">PowerShell で claude コマンドを検索できませんでした。</sys:String>
    <sys:String x:Key="EvidenceUnsupportedCommandType">PowerShell がサポート対象外のコマンド形式を見つけました。</sys:String>
    <sys:String x:Key="EvidenceSignatureCheckFailed">実行ファイルの署名を確認できませんでした。</sys:String>
    <sys:String x:Key="EvidenceSignatureUnverified">実行ファイルの署名を検証できませんでした。</sys:String>
    <sys:String x:Key="EvidenceVersionCheckFailed">CLI のバージョンを確認できませんでした。</sys:String>
    <sys:String x:Key="EvidenceAuthStatusUnverified">CLI のログイン状態を確認できませんでした。</sys:String>
    <sys:String x:Key="EvidencePathEntryUnsupported">ランチャーからこのフォルダーを PATH に追加できません。</sys:String>
    <sys:String x:Key="EvidencePathTargetChanged">PowerShell が別のフォルダーにあるコマンドを見つけました。</sys:String>
    <sys:String x:Key="EvidenceUserPathChanged">修復中に保存済みのユーザー PATH が変わりました。再確認してからやり直してください。</sys:String>
    <sys:String x:Key="EvidencePathVerificationFailed">PATH の更新後もコマンドを確認できませんでした。</sys:String>
    <sys:String x:Key="EvidenceWinGetUnavailable">所定の場所に WinGet が見つかりませんでした。</sys:String>
    <sys:String x:Key="EvidenceWinGetStartFailed">WinGet を起動できませんでした。</sys:String>
    <sys:String x:Key="EvidenceWinGetTimeoutTerminationUnverified">WinGet が制限時間内に完了しませんでした。まだ動作しているか確認してから再試行してください。</sys:String>
    <sys:String x:Key="EvidenceWinGetTimeout">WinGet が制限時間内に完了しませんでした。インストール状態を確認してから再試行してください。</sys:String>
    <sys:String x:Key="EvidenceWinGetVerificationFailed">WinGet は完了しましたが、ランチャーで Claude Code が見つかりませんでした。</sys:String>
    <sys:String x:Key="EvidenceWinGetPackageConsentRequired">PowerShell で以下のコマンドを実行し、パッケージの使用条件を確認してください。</sys:String>
    <sys:String x:Key="EvidenceWinGetSourceConsentRequired">PowerShell で以下のコマンドを実行し、WinGet ソースの使用条件を確認してください。</sys:String>
    <sys:String x:Key="EvidenceWinGetInstallFailed">WinGet でインストールエラーが発生しました。</sys:String>
    <sys:String x:Key="SessionsPartialWithFolders">一部の会話を読み込めませんでした。下のフォルダーを選ぶと、そのフォルダーの会話一覧が CLI で開きます。</sys:String>
    <sys:String x:Key="EvidenceWinGetAlreadyRunning">この Windows セッションで WinGet が実行中です。終了後に再確認してください。</sys:String>
    <sys:String x:Key="EvidenceWorkingFolderUnavailable">PowerShell で選択したフォルダーを開けませんでした。</sys:String>
    <sys:String x:Key="EvidenceInstallationFootprintFound">以前のインストールのファイルまたは登録が見つかりました。Claude Code が起動するかは確認できませんでした。</sys:String>
    <sys:String x:Key="EvidencePowerShellStartFailed">確認用の PowerShell を起動できませんでした。</sys:String>
    <sys:String x:Key="EvidencePowerShellTimeout">PowerShell による確認が制限時間内に終わりませんでした。</sys:String>
    <sys:String x:Key="EvidencePowerShellExitFailed">確認中に PowerShell がエラーで終了しました。</sys:String>
    <sys:String x:Key="EvidencePowerShellOutputInvalid">PowerShell の確認結果を読み取れませんでした。</sys:String>
    <sys:String x:Key="EvidencePowerShellProbeFailed">PowerShell による確認を完了できませんでした。</sys:String>
</ResourceDictionary>
