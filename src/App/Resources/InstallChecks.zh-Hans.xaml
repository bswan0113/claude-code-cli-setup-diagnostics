<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:String x:Key="CheckInstallBinaryVerifiedTitle">Claude Code 可执行文件正常</sys:String>
    <sys:String x:Key="CheckInstallBinaryVerifiedCause">已核验 Anthropic 签名和 CLI 版本。</sys:String>
    <sys:String x:Key="CheckInstallBinaryVerifiedSolution">可以继续使用此可执行文件。</sys:String>
    <sys:String x:Key="CheckInstallBinaryUnknownTitle">无法确认可执行文件状态</sys:String>
    <sys:String x:Key="CheckInstallBinaryUnknownCause">无法读取文件或确认启动状态。</sys:String>
    <sys:String x:Key="CheckInstallBinaryUnknownSolution">检查文件和文件夹的访问权限，然后重新检查。</sys:String>
    <sys:String x:Key="CheckInstallBinaryMissingTitle">找不到 Claude Code 可执行文件</sys:String>
    <sys:String x:Key="CheckInstallBinaryMissingCause">在已知安装位置中未找到可执行文件。</sys:String>
    <sys:String x:Key="CheckInstallBinaryMissingSolution">请从已验证的备份恢复，或使用官方 PowerShell 命令安装。</sys:String>
    <sys:String x:Key="CheckInstallBinaryDamagedTitle">可执行文件验证失败</sys:String>
    <sys:String x:Key="CheckInstallBinaryDamagedCause">无法确认官方签名或正常的版本响应。</sys:String>
    <sys:String x:Key="CheckInstallBinaryDamagedSolution">请检查所示文件。若可恢复或重装，选项会显示在下方。</sys:String>
    <sys:String x:Key="CheckInstallBackupUnverifiedTitle">没有已核验的备份</sys:String>
    <sys:String x:Key="CheckInstallBackupUnverifiedCause">无法核验候选备份的 Anthropic 签名。</sys:String>
    <sys:String x:Key="CheckInstallBackupUnverifiedSolution">请使用官方 PowerShell 安装命令，或查看官方安装指南。</sys:String>
    <sys:String x:Key="CheckInstallBackupAvailableTitle">已签名的 Claude Code 备份</sys:String>
    <sys:String x:Key="CheckInstallBackupAvailableCause">更新后留有带官方签名的备份。</sys:String>
    <sys:String x:Key="CheckInstallBackupAvailableSolution">先测试所选备份能否运行，再进行恢复。现有可执行文件会另行保留。</sys:String>
    <sys:String x:Key="CheckInstallNativeRecoveryTitle">使用官方安装程序修复 Claude Code</sys:String>
    <sys:String x:Key="CheckInstallNativeRecoveryCause">未能在当前安装中找到可正常运行的可执行文件。</sys:String>
    <sys:String x:Key="CheckInstallNativeRecoverySolution">确认后将运行官方 PowerShell 安装程序并验证可执行文件。仅在连续 5 分钟没有进展且已确认安装程序停止后，才尝试 WinGet。</sys:String>
    <sys:String x:Key="CheckInstallProcessesClearTitle">没有 Claude 会话占用安装文件</sys:String>
    <sys:String x:Key="CheckInstallProcessesClearCause">在已知安装路径中未发现运行中的 Claude 进程。</sys:String>
    <sys:String x:Key="CheckInstallProcessesClearSolution">此项检查无需关闭 Claude 进程。</sys:String>
    <sys:String x:Key="CheckInstallProcessUnknownTitle">无法核验部分 Claude 进程</sys:String>
    <sys:String x:Key="CheckInstallProcessUnknownCause">无法确认部分进程的可执行文件路径。</sys:String>
    <sys:String x:Key="CheckInstallProcessUnknownSolution">请手动关闭 Claude 窗口，再重新检查。</sys:String>
    <sys:String x:Key="CheckInstallProcessRunningTitle">Claude 会话正在运行</sys:String>
    <sys:String x:Key="CheckInstallProcessRunningCause">Claude 正从所示安装路径运行。</sys:String>
    <sys:String x:Key="CheckInstallProcessRunningSolution">无需操作。</sys:String>
    <sys:String x:Key="CheckInstallProcessActiveTitle">清理或修复前需要关闭 Claude</sys:String>
    <sys:String x:Key="CheckInstallProcessActiveCause">正在运行的 Claude 可能占用待更换或清理的文件。</sys:String>
    <sys:String x:Key="CheckInstallProcessActiveSolution">请先保存工作。批准后只会结束所示 PID，并中断该进程的对话。</sys:String>
    <sys:String x:Key="CheckInstallProcessOtherSessionTitle">其他账户或 Windows 会话中的 Claude 进程</sys:String>
    <sys:String x:Key="CheckInstallProcessOtherSessionCause">无法确认进程所有者，或当前会话是否可以结束它。</sys:String>
    <sys:String x:Key="CheckInstallProcessOtherSessionSolution">请在对应账户或会话中完成工作后关闭 Claude。</sys:String>
    <sys:String x:Key="CheckInstallPathUnknownTitle">无法检查 PATH</sys:String>
    <sys:String x:Key="CheckInstallPathUnknownCause">无法读取已保存的 PATH 或 PowerShell 命令搜索结果。</sys:String>
    <sys:String x:Key="CheckInstallPathUnknownSolution">打开新的 PowerShell，运行 Get-Command claude -All。</sys:String>
    <sys:String x:Key="CheckInstallPathDeferredTitle">请先确认安装状态</sys:String>
    <sys:String x:Key="CheckInstallPathDeferredCause">尚未找到可加入 PATH 的已核验官方可执行文件。</sys:String>
    <sys:String x:Key="CheckInstallPathDeferredSolution">请先查看可执行文件检查项。</sys:String>
    <sys:String x:Key="CheckInstallPathStaleTitle">需要刷新启动器的 PATH</sys:String>
    <sys:String x:Key="CheckInstallPathStaleCause">新 PowerShell 与当前启动器使用的 PATH 不同。</sys:String>
    <sys:String x:Key="CheckInstallPathStaleSolution">刷新启动器进程的 PATH 后重试。</sys:String>
    <sys:String x:Key="CheckInstallPathMissingTitle">已保存的 PATH 缺少安装文件夹</sys:String>
    <sys:String x:Key="CheckInstallPathMissingCause">已核验的安装文件夹不在已保存的 PATH 中。</sys:String>
    <sys:String x:Key="CheckInstallPathMissingSolution">如果可以加入用户 PATH，这里会显示相应操作。</sys:String>
    <sys:String x:Key="CheckInstallPathReadyTitle">安装文件夹已加入 PATH</sys:String>
    <sys:String x:Key="CheckInstallPathReadyCause">已在保存的 PATH 中找到安装文件夹。</sys:String>
    <sys:String x:Key="CheckInstallPathReadySolution">保留现有路径条目即可。</sys:String>
    <sys:String x:Key="CheckInstallPathPriorityTitle">另一个 Claude 路径优先</sys:String>
    <sys:String x:Key="CheckInstallPathPriorityCause">较前的路径先匹配到同名命令。</sys:String>
    <sys:String x:Key="CheckInstallPathPrioritySolution">将已核验的安装文件夹移到用户 PATH 开头。</sys:String>
    <sys:String x:Key="CheckInstallPathShadowedTitle">仅调整用户 PATH 顺序无法解决冲突</sys:String>
    <sys:String x:Key="CheckInstallPathShadowedCause">调整用户 PATH 后，其他命令仍优先匹配。</sys:String>
    <sys:String x:Key="CheckInstallPathShadowedSolution">检查所示路径中的 npm 重复安装或应用执行别名。系统 PATH 请与管理员确认。</sys:String>
    <sys:String x:Key="CheckInstallCommandUnknownTitle">无法确认 Claude 命令搜索顺序</sys:String>
    <sys:String x:Key="CheckInstallCommandUnknownCause">无法读取 PowerShell 搜索结果。</sys:String>
    <sys:String x:Key="CheckInstallCommandUnknownSolution">使用 Get-Command claude -All 确认。</sys:String>
    <sys:String x:Key="CheckInstallCommandAbsentTitle">当前 PowerShell 找不到 Claude 命令</sys:String>
    <sys:String x:Key="CheckInstallCommandAbsentCause">启动器继承的 PATH 无法解析 Claude 命令。</sys:String>
    <sys:String x:Key="CheckInstallCommandAbsentSolution">查看可执行文件和 PATH 的检查结果。</sys:String>
    <sys:String x:Key="CheckInstallCommandOrderTitle">当前 PowerShell 的 Claude 搜索顺序</sys:String>
    <sys:String x:Key="CheckInstallCommandOrderCause">PowerShell 使用列表中第一个匹配的命令。</sys:String>
    <sys:String x:Key="CheckInstallCommandOrderSolution">如果打开了其他 Claude，请检查第一个路径。</sys:String>
    <sys:String x:Key="CheckInstallDesktopAliasTitle">Windows 应用执行别名优先</sys:String>
    <sys:String x:Key="CheckInstallDesktopAliasCause">WindowsApps 中的 Claude 别名是第一个匹配项。</sys:String>
    <sys:String x:Key="CheckInstallDesktopAliasSolution">查看 Windows 应用执行别名设置，或调整已核验 CLI 的路径优先级。</sys:String>
    <sys:String x:Key="CheckInstallStoredCommandOrderTitle">已保存 PATH 的 Claude 搜索顺序</sys:String>
    <sys:String x:Key="CheckInstallStoredCommandOrderCause">当前启动器与已保存的 PATH 搜索结果不同。</sys:String>
    <sys:String x:Key="CheckInstallStoredCommandOrderSolution">刷新 PATH 后在新的 PowerShell 中确认顺序。</sys:String>
    <sys:String x:Key="CheckInstallDuplicatesUnknownTitle">重复安装检查不完整</sys:String>
    <sys:String x:Key="CheckInstallDuplicatesUnknownCause">无法读取 npm 或旧安装路径。</sys:String>
    <sys:String x:Key="CheckInstallDuplicatesUnknownSolution">检查安装路径和权限，然后重新检查。</sys:String>
    <sys:String x:Key="CheckInstallNpmDuplicateTitle">存在重复的 npm 全局安装</sys:String>
    <sys:String x:Key="CheckInstallNpmDuplicateCause">已核验的可执行文件之外还存在 npm 全局软件包。</sys:String>
    <sys:String x:Key="CheckInstallNpmDuplicateSolution">在可验证当前用户范围时，只移除所示 npm 软件包。</sys:String>
    <sys:String x:Key="CheckInstallNpmOnlyTitle">发现 npm 全局安装</sys:String>
    <sys:String x:Key="CheckInstallNpmOnlyCause">已找到 npm 软件包，但尚未验证可替代的官方可执行文件。</sys:String>
    <sys:String x:Key="CheckInstallNpmOnlySolution">请先安装或恢复可用的官方可执行文件。</sys:String>
    <sys:String x:Key="CheckInstallLegacyTitle">旧版 Claude 安装文件</sys:String>
    <sys:String x:Key="CheckInstallLegacyCause">旧安装方式留下了 .claude\local 文件夹。</sys:String>
    <sys:String x:Key="CheckInstallLegacySolution">确认正常安装可用后，只删除列出的普通文件。</sys:String>
    <sys:String x:Key="CheckInstallCleanupUnknownTitle">无法确认清理目标</sys:String>
    <sys:String x:Key="CheckInstallCleanupUnknownCause">无法读取缓存或更新文件的路径。</sys:String>
    <sys:String x:Key="CheckInstallCleanupUnknownSolution">检查文件夹的访问权限，然后重新检查。</sys:String>
    <sys:String x:Key="CheckInstallDebrisClearTitle">没有需要删除的更新残留文件</sys:String>
    <sys:String x:Key="CheckInstallDebrisClearCause">没有清理候选文件。若保留了最新备份，会显示其路径。</sys:String>
    <sys:String x:Key="CheckInstallDebrisClearSolution">保留所示备份。</sys:String>
    <sys:String x:Key="CheckInstallDebrisTitle">更新残留文件</sys:String>
    <sys:String x:Key="CheckInstallDebrisCause">安装目录留有替换时产生的 old、new 或 broken 文件。</sys:String>
    <sys:String x:Key="CheckInstallDebrisSolution">可执行文件正常时，仅删除所示文件，并保留最新的 old 备份。</sys:String>
    <sys:String x:Key="CheckInstallDownloadsClearTitle">没有需要删除的下载缓存</sys:String>
    <sys:String x:Key="CheckInstallDownloadsClearCause">下载缓存中没有可清理的普通文件。</sys:String>
    <sys:String x:Key="CheckInstallDownloadsClearSolution">无需清理下载缓存。</sys:String>
    <sys:String x:Key="CheckInstallDownloadsTitle">安装下载缓存</sys:String>
    <sys:String x:Key="CheckInstallDownloadsCause">安装程序的下载目录中留有普通文件。</sys:String>
    <sys:String x:Key="CheckInstallDownloadsSolution">请等安装或更新结束。批准后只会删除所列缓存文件。</sys:String>
    <sys:String x:Key="CheckInstallUpdaterDisabledTitle">已确认自动更新禁用设置</sys:String>
    <sys:String x:Key="CheckInstallUpdaterDisabledCause">在用户、系统或当前进程环境中找到禁用标记。</sys:String>
    <sys:String x:Key="CheckInstallUpdaterDisabledSolution">需要更新时，请关闭 Claude 并运行 claude update。</sys:String>
    <sys:String x:Key="CheckInstallUpdaterRiskTitle">检查自动更新设置</sys:String>
    <sys:String x:Key="CheckInstallUpdaterRiskCause">可执行文件验证失败，或存在更新残留文件。</sys:String>
    <sys:String x:Key="CheckInstallUpdaterRiskSolution">如有需要，可为当前用户关闭自动更新，之后使用 claude update 手动更新。</sys:String>
    <sys:String x:Key="CheckInstallUpdaterWinGetTitle">WinGet 安装的更新</sys:String>
    <sys:String x:Key="CheckInstallUpdaterWinGetCause">WinGet 安装默认使用手动更新。</sys:String>
    <sys:String x:Key="CheckInstallUpdaterWinGetSolution">请使用所示 WinGet 命令更新。</sys:String>
    <sys:String x:Key="CheckInstallUpdaterWinGetEnabledTitle">发现 WinGet 自动更新设置</sys:String>
    <sys:String x:Key="CheckInstallUpdaterWinGetEnabledCause">启动器环境中设置了软件包管理器自动更新标记。</sys:String>
    <sys:String x:Key="CheckInstallUpdaterWinGetEnabledSolution">如需手动更新，请使用所示 WinGet 命令。</sys:String>
    <sys:String x:Key="CheckInstallUpdaterStatusTitle">自动更新环境设置</sys:String>
    <sys:String x:Key="CheckInstallUpdaterStatusCause">在已检查的 Windows 环境中未发现禁用标记。</sys:String>
    <sys:String x:Key="CheckInstallUpdaterStatusSolution">请用 claude doctor 确认实际的自动更新状态。</sys:String>
    <sys:String x:Key="FixStopClaudeProcess">结束所选 Claude 进程</sys:String>
    <sys:String x:Key="FixRestoreClaudeBackup">恢复此备份</sys:String>
    <sys:String x:Key="FixInstallClaudeNative">运行官方安装命令</sys:String>
    <sys:String x:Key="FixRefreshClaudeProcessPath">刷新启动器 PATH</sys:String>
    <sys:String x:Key="FixPreferClaudePath">调整用户 PATH 优先级</sys:String>
    <sys:String x:Key="FixRemoveClaudeNpm">移除此 npm 全局软件包</sys:String>
    <sys:String x:Key="FixCleanClaudeLegacy">删除所列旧版文件</sys:String>
    <sys:String x:Key="FixCleanClaudeDebris">删除所列更新残留文件</sys:String>
    <sys:String x:Key="FixCleanClaudeDownloads">删除所列下载缓存</sys:String>
    <sys:String x:Key="FixDisableClaudeUpdater">为当前用户关闭自动更新</sys:String>
    <sys:String x:Key="CheckInstallBinaryHashMismatchTitle">Claude Code 可执行文件与签名不符</sys:String>
    <sys:String x:Key="CheckInstallBinaryHashMismatchCause">Windows 检测到文件内容与签名时不同。启动器已阻止运行此文件。</sys:String>
    <sys:String x:Key="CheckInstallBinaryHashMismatchSolution">如果有适用于此文件且已验证的备份，可确认后恢复。若未提供恢复操作，请关闭 Claude Code，核对所示安装路径后再次检查。</sys:String>
    <sys:String x:Key="CheckInstallBinaryUnsignedTitle">Claude Code 可执行文件没有数字签名</sys:String>
    <sys:String x:Key="CheckInstallBinaryUnsignedCause">文件存在，但 Windows 没有找到 Authenticode 签名。启动器无法确认发布者，已阻止运行。</sys:String>
    <sys:String x:Key="CheckInstallBinaryUnsignedSolution">如果有适用于此文件且已验证的备份，可确认后恢复。若未提供恢复操作，请关闭 Claude Code，核对所示安装路径后再次检查。</sys:String>
    <sys:String x:Key="CheckInstallBinaryOtherPublisherTitle">Claude Code 可执行文件由其他发布者签名</sys:String>
    <sys:String x:Key="CheckInstallBinaryOtherPublisherCause">Windows 已验证签名，但发布者与 Anthropic, PBC 不符。启动器已阻止运行此文件。</sys:String>
    <sys:String x:Key="CheckInstallBinaryOtherPublisherSolution">如果有适用于此文件且已验证的备份，可确认后恢复。若未提供恢复操作，请关闭 Claude Code，核对所示安装路径后再次检查。</sys:String>
    <sys:String x:Key="CheckInstallBinaryTrustUnknownTitle">无法确认可执行文件是否可信</sys:String>
    <sys:String x:Key="CheckInstallBinaryTrustUnknownCause">检查未能确定签名状态，启动器已暂停对此文件的修复。</sys:String>
    <sys:String x:Key="CheckInstallBinaryTrustUnknownSolution">请检查文件的读取权限，在 Windows 文件属性 → 数字签名中核对签名者，然后重新检查。</sys:String>
    <sys:String x:Key="CheckInstallBinaryExecutionFailedTitle">已签名的可执行文件未返回有效的 Claude Code 版本</sys:String>
    <sys:String x:Key="CheckInstallBinaryExecutionFailedCause">Anthropic 签名有效，但版本检查没有收到预期的 Claude Code 响应。</sys:String>
    <sys:String x:Key="CheckInstallBinaryExecutionFailedSolution">如果有适用于此文件且已验证的备份，可确认后恢复。若未提供恢复操作，请关闭 Claude Code，核对所示安装路径后再次检查。</sys:String>
    <sys:String x:Key="GuidedPreserveExecutable">如果确认，启动器会单独保留当前文件，并把已验证的备份恢复到此位置。</sys:String>
    <sys:String x:Key="GuidedExecutableReview">启动器未能确认适用于此文件的安全恢复方法。请关闭已打开的 Claude Code，核对所示路径对应的安装版本，然后重新检查。</sys:String>
    <sys:String x:Key="GuidedNativeExecutableReview">关闭 Claude Code。请勿运行所示文件，在文件资源管理器中将它改为尚未使用的名称（如 claude.exe.saved）并保留。然后重新检查。如果可执行文件现已缺失且满足安装条件，启动器会提供官方安装程序。</sys:String>
    <sys:String x:Key="GuidedExternalExecutableReview">请保留此文件的原位置，检查 PowerShell 在 PATH 中优先找到哪个 claude 命令。如果是 WinGet 或其他工具安装的文件，请用相应工具修复后再检查。</sys:String>
</ResourceDictionary>
