<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:String x:Key="CheckInstallBinaryVerifiedTitle">Verified Claude Code executable</sys:String>
    <sys:String x:Key="CheckInstallBinaryVerifiedCause">The Anthropic signature and CLI version were verified.</sys:String>
    <sys:String x:Key="CheckInstallBinaryVerifiedSolution">Keep using this executable.</sys:String>
    <sys:String x:Key="CheckInstallBinaryUnknownTitle">Executable status unavailable</sys:String>
    <sys:String x:Key="CheckInstallBinaryUnknownCause">The executable or its launch status could not be read.</sys:String>
    <sys:String x:Key="CheckInstallBinaryUnknownSolution">Check access to the file and its folder, then scan again.</sys:String>
    <sys:String x:Key="CheckInstallBinaryMissingTitle">Claude Code executable missing</sys:String>
    <sys:String x:Key="CheckInstallBinaryMissingCause">No executable was found in the known installation locations.</sys:String>
    <sys:String x:Key="CheckInstallBinaryMissingSolution">Restore a verified backup or install with WinGet.</sys:String>
    <sys:String x:Key="CheckInstallBinaryDamagedTitle">Executable verification failed</sys:String>
    <sys:String x:Key="CheckInstallBinaryDamagedCause">The official signature or CLI version could not be verified.</sys:String>
    <sys:String x:Key="CheckInstallBinaryDamagedSolution">Review the file shown. Available restore or reinstall actions are listed below.</sys:String>
    <sys:String x:Key="CheckInstallBackupUnverifiedTitle">No verified backup found</sys:String>
    <sys:String x:Key="CheckInstallBackupUnverifiedCause">The Anthropic signature could not be verified on the backup candidates.</sys:String>
    <sys:String x:Key="CheckInstallBackupUnverifiedSolution">Check the WinGet recovery option or follow the official setup instructions.</sys:String>
    <sys:String x:Key="CheckInstallBackupAvailableTitle">Signed Claude Code backup</sys:String>
    <sys:String x:Key="CheckInstallBackupAvailableCause">A backup with an official signature remains after an update.</sys:String>
    <sys:String x:Key="CheckInstallBackupAvailableSolution">The selected backup is tested before restoration. Any existing executable is saved separately.</sys:String>
    <sys:String x:Key="CheckInstallWinGetRecoveryTitle">Recover Claude Code with WinGet</sys:String>
    <sys:String x:Key="CheckInstallWinGetRecoveryCause">No working executable was verified in the current installation.</sys:String>
    <sys:String x:Key="CheckInstallWinGetRecoverySolution">Close running Claude sessions. On approval, WinGet installs the official package for your user and the launcher checks its version.</sys:String>
    <sys:String x:Key="CheckInstallWinGetUnavailableTitle">WinGet executable unavailable</sys:String>
    <sys:String x:Key="CheckInstallWinGetUnavailableCause">The WinGet executable for this user was not found.</sys:String>
    <sys:String x:Key="CheckInstallWinGetUnavailableSolution">Check App Installer in Microsoft Store or follow the official Claude Code setup instructions.</sys:String>
    <sys:String x:Key="CheckInstallProcessesClearTitle">No Claude sessions using the install files</sys:String>
    <sys:String x:Key="CheckInstallProcessesClearCause">No running Claude process was found in the known installation paths.</sys:String>
    <sys:String x:Key="CheckInstallProcessesClearSolution">No Claude process needs to be closed for this check.</sys:String>
    <sys:String x:Key="CheckInstallProcessUnknownTitle">Some Claude processes could not be verified</sys:String>
    <sys:String x:Key="CheckInstallProcessUnknownCause">The executable path could not be verified for some processes.</sys:String>
    <sys:String x:Key="CheckInstallProcessUnknownSolution">Close the Claude windows yourself, then scan again.</sys:String>
    <sys:String x:Key="CheckInstallProcessRunningTitle">Claude session running</sys:String>
    <sys:String x:Key="CheckInstallProcessRunningCause">Claude is running from the installation path shown.</sys:String>
    <sys:String x:Key="CheckInstallProcessRunningSolution">No action is required.</sys:String>
    <sys:String x:Key="CheckInstallProcessActiveTitle">Close Claude before cleanup or repair</sys:String>
    <sys:String x:Key="CheckInstallProcessActiveCause">A running Claude process may be using the files to be changed.</sys:String>
    <sys:String x:Key="CheckInstallProcessActiveSolution">Save your work first. Approval ends only the listed PID and interrupts its conversation.</sys:String>
    <sys:String x:Key="CheckInstallProcessOtherSessionTitle">Claude process in another account or session</sys:String>
    <sys:String x:Key="CheckInstallProcessOtherSessionCause">Ownership or permission to stop this process from the current session could not be verified.</sys:String>
    <sys:String x:Key="CheckInstallProcessOtherSessionSolution">Finish the Claude work in the relevant account or session and close it there.</sys:String>
    <sys:String x:Key="CheckInstallPathUnknownTitle">PATH check unavailable</sys:String>
    <sys:String x:Key="CheckInstallPathUnknownCause">The saved PATH or PowerShell command lookup could not be read.</sys:String>
    <sys:String x:Key="CheckInstallPathUnknownSolution">Run Get-Command claude -All in a new PowerShell window.</sys:String>
    <sys:String x:Key="CheckInstallPathDeferredTitle">Verify the installation first</sys:String>
    <sys:String x:Key="CheckInstallPathDeferredCause">No verified official executable is available for the PATH check.</sys:String>
    <sys:String x:Key="CheckInstallPathDeferredSolution">Review the executable check first.</sys:String>
    <sys:String x:Key="CheckInstallPathStaleTitle">Launcher PATH needs a refresh</sys:String>
    <sys:String x:Key="CheckInstallPathStaleCause">A fresh PowerShell sees a different PATH from the running launcher.</sys:String>
    <sys:String x:Key="CheckInstallPathStaleSolution">Refresh the launcher process PATH, then try again.</sys:String>
    <sys:String x:Key="CheckInstallPathMissingTitle">Installation folder missing from saved PATH</sys:String>
    <sys:String x:Key="CheckInstallPathMissingCause">The verified install folder is absent from the saved PATH.</sys:String>
    <sys:String x:Key="CheckInstallPathMissingSolution">An action is available here if the folder can be added to the user PATH.</sys:String>
    <sys:String x:Key="CheckInstallPathReadyTitle">Installation folder is on PATH</sys:String>
    <sys:String x:Key="CheckInstallPathReadyCause">The install folder was found in the saved PATH.</sys:String>
    <sys:String x:Key="CheckInstallPathReadySolution">Keep the existing path entry.</sys:String>
    <sys:String x:Key="CheckInstallPathPriorityTitle">Another Claude path comes first</sys:String>
    <sys:String x:Key="CheckInstallPathPriorityCause">An earlier path resolves the same command before the verified executable.</sys:String>
    <sys:String x:Key="CheckInstallPathPrioritySolution">Move the verified install folder to the front of the user PATH.</sys:String>
    <sys:String x:Key="CheckInstallPathShadowedTitle">User PATH order cannot resolve the conflict</sys:String>
    <sys:String x:Key="CheckInstallPathShadowedCause">A different command still resolves first after reordering the user PATH.</sys:String>
    <sys:String x:Key="CheckInstallPathShadowedSolution">Check the shown path for an npm duplicate or app execution alias. Review system PATH with your administrator.</sys:String>
    <sys:String x:Key="CheckInstallCommandUnknownTitle">Claude command order unavailable</sys:String>
    <sys:String x:Key="CheckInstallCommandUnknownCause">PowerShell command lookup could not be read.</sys:String>
    <sys:String x:Key="CheckInstallCommandUnknownSolution">Check the result with Get-Command claude -All.</sys:String>
    <sys:String x:Key="CheckInstallCommandAbsentTitle">Claude command absent from the current PowerShell</sys:String>
    <sys:String x:Key="CheckInstallCommandAbsentCause">The launcher’s inherited PATH does not resolve the Claude command.</sys:String>
    <sys:String x:Key="CheckInstallCommandAbsentSolution">Review the executable and PATH checks.</sys:String>
    <sys:String x:Key="CheckInstallCommandOrderTitle">Claude lookup order in the current PowerShell</sys:String>
    <sys:String x:Key="CheckInstallCommandOrderCause">PowerShell uses the first matching command in the list.</sys:String>
    <sys:String x:Key="CheckInstallCommandOrderSolution">If a different Claude opens, check the first path.</sys:String>
    <sys:String x:Key="CheckInstallDesktopAliasTitle">Windows app execution alias comes first</sys:String>
    <sys:String x:Key="CheckInstallDesktopAliasCause">The Claude alias in WindowsApps is the first command match.</sys:String>
    <sys:String x:Key="CheckInstallDesktopAliasSolution">Check Windows app execution aliases or give the verified CLI path precedence.</sys:String>
    <sys:String x:Key="CheckInstallStoredCommandOrderTitle">Claude lookup order on the saved PATH</sys:String>
    <sys:String x:Key="CheckInstallStoredCommandOrderCause">The saved PATH gives a different lookup order from the running launcher.</sys:String>
    <sys:String x:Key="CheckInstallStoredCommandOrderSolution">After refreshing PATH, check the order in a new PowerShell window.</sys:String>
    <sys:String x:Key="CheckInstallDuplicatesUnknownTitle">Duplicate installation check incomplete</sys:String>
    <sys:String x:Key="CheckInstallDuplicatesUnknownCause">An npm or legacy installation path could not be read.</sys:String>
    <sys:String x:Key="CheckInstallDuplicatesUnknownSolution">Check the install paths and their permissions, then scan again.</sys:String>
    <sys:String x:Key="CheckInstallNpmDuplicateTitle">Duplicate global npm install</sys:String>
    <sys:String x:Key="CheckInstallNpmDuplicateCause">A global npm package exists alongside the verified executable.</sys:String>
    <sys:String x:Key="CheckInstallNpmDuplicateSolution">When the user scope can be verified, remove only the listed npm package.</sys:String>
    <sys:String x:Key="CheckInstallNpmOnlyTitle">Global npm install found</sys:String>
    <sys:String x:Key="CheckInstallNpmOnlyCause">An npm package was found, but no working official replacement was verified.</sys:String>
    <sys:String x:Key="CheckInstallNpmOnlySolution">Install or recover a verified official executable first.</sys:String>
    <sys:String x:Key="CheckInstallLegacyTitle">Legacy Claude installation files</sys:String>
    <sys:String x:Key="CheckInstallLegacyCause">The .claude\local folder from an earlier installation method is still present.</sys:String>
    <sys:String x:Key="CheckInstallLegacySolution">After verifying a working installation, remove only the listed regular files.</sys:String>
    <sys:String x:Key="CheckInstallCleanupUnknownTitle">Cleanup targets unavailable</sys:String>
    <sys:String x:Key="CheckInstallCleanupUnknownCause">A cache or updater file path could not be read.</sys:String>
    <sys:String x:Key="CheckInstallCleanupUnknownSolution">Check access to the folder, then scan again.</sys:String>
    <sys:String x:Key="CheckInstallDebrisClearTitle">No updater leftovers to delete</sys:String>
    <sys:String x:Key="CheckInstallDebrisClearCause">There are no cleanup candidates. If a newest backup is being kept, its path is shown.</sys:String>
    <sys:String x:Key="CheckInstallDebrisClearSolution">Leave any listed backup in place.</sys:String>
    <sys:String x:Key="CheckInstallDebrisTitle">Updater leftover files</sys:String>
    <sys:String x:Key="CheckInstallDebrisCause">The install folder contains old, new, or broken files from a replacement attempt.</sys:String>
    <sys:String x:Key="CheckInstallDebrisSolution">When the executable is healthy, delete only the listed files and keep the newest old backup.</sys:String>
    <sys:String x:Key="CheckInstallDownloadsClearTitle">No download cache files to delete</sys:String>
    <sys:String x:Key="CheckInstallDownloadsClearCause">No regular files were found to clean in the download cache.</sys:String>
    <sys:String x:Key="CheckInstallDownloadsClearSolution">No download cache cleanup is needed.</sys:String>
    <sys:String x:Key="CheckInstallDownloadsTitle">Installer download cache</sys:String>
    <sys:String x:Key="CheckInstallDownloadsCause">Regular files remain in the installer download folder.</sys:String>
    <sys:String x:Key="CheckInstallDownloadsSolution">Wait for any installation or update to finish. Approval deletes only the listed cache files.</sys:String>
    <sys:String x:Key="CheckInstallUpdaterDisabledTitle">Automatic updater disabled in the environment</sys:String>
    <sys:String x:Key="CheckInstallUpdaterDisabledCause">The disable flag was found in the user, system, or process environment.</sys:String>
    <sys:String x:Key="CheckInstallUpdaterDisabledSolution">When an update is needed, close Claude and run claude update.</sys:String>
    <sys:String x:Key="CheckInstallUpdaterRiskTitle">Review automatic updates</sys:String>
    <sys:String x:Key="CheckInstallUpdaterRiskCause">Executable verification failed or updater leftovers are present.</sys:String>
    <sys:String x:Key="CheckInstallUpdaterRiskSolution">If needed, disable automatic updates for your user and run claude update manually.</sys:String>
    <sys:String x:Key="CheckInstallUpdaterWinGetTitle">Updates for the WinGet install</sys:String>
    <sys:String x:Key="CheckInstallUpdaterWinGetCause">WinGet installations use manual updates by default.</sys:String>
    <sys:String x:Key="CheckInstallUpdaterWinGetSolution">Use the WinGet upgrade command shown.</sys:String>
    <sys:String x:Key="CheckInstallUpdaterWinGetEnabledTitle">WinGet automatic update opt-in detected</sys:String>
    <sys:String x:Key="CheckInstallUpdaterWinGetEnabledCause">The launcher environment contains the package manager auto-update flag.</sys:String>
    <sys:String x:Key="CheckInstallUpdaterWinGetEnabledSolution">Use the WinGet upgrade command shown if you need to update manually.</sys:String>
    <sys:String x:Key="CheckInstallUpdaterStatusTitle">Automatic update environment check</sys:String>
    <sys:String x:Key="CheckInstallUpdaterStatusCause">The disable flag was not found in the Windows environments checked.</sys:String>
    <sys:String x:Key="CheckInstallUpdaterStatusSolution">Run claude doctor to check the updater’s effective state.</sys:String>
    <sys:String x:Key="FixStopClaudeProcess">End the selected Claude process</sys:String>
    <sys:String x:Key="FixRestoreClaudeBackup">Restore this backup</sys:String>
    <sys:String x:Key="FixReinstallClaudeWinGet">Run official WinGet install</sys:String>
    <sys:String x:Key="FixRefreshClaudeProcessPath">Refresh launcher PATH</sys:String>
    <sys:String x:Key="FixPreferClaudePath">Prioritize the install in user PATH</sys:String>
    <sys:String x:Key="FixRemoveClaudeNpm">Remove this global npm package</sys:String>
    <sys:String x:Key="FixCleanClaudeLegacy">Delete listed legacy files</sys:String>
    <sys:String x:Key="FixCleanClaudeDebris">Delete listed updater leftovers</sys:String>
    <sys:String x:Key="FixCleanClaudeDownloads">Delete listed download cache files</sys:String>
    <sys:String x:Key="FixDisableClaudeUpdater">Disable automatic updates for this user</sys:String>
</ResourceDictionary>
