<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ControlTemplate x:Key="KeyboardFocusOutline" TargetType="Control">
        <Border BorderBrush="{DynamicResource HeaderInk}" BorderThickness="2">
            <Border BorderBrush="{DynamicResource Header}" BorderThickness="2" />
        </Border>
    </ControlTemplate>
    <Style x:Key="ItemHighlightMarker" TargetType="Border">
        <Setter Property="Width" Value="4" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Background" Value="{DynamicResource FocusLine}" />
        <Setter Property="Visibility" Value="Hidden" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Font25}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="{DynamicResource Font23}" />
    </Style>
    <Style x:Key="Action" TargetType="Button">
        <Setter Property="Padding" Value="15,7" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="SurfaceBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <Control x:Name="KeyboardFocusRing" Template="{StaticResource KeyboardFocusOutline}"
                                 Focusable="False" IsHitTestVisible="False" Visibility="Hidden" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="SurfaceBorder" Property="Opacity" Value="0.77" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="SurfaceBorder" Property="Opacity" Value="0.56" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="KeyboardFocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="SurfaceBorder" Property="Opacity" Value="0.48" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PrimaryAction" TargetType="Button" BasedOn="{StaticResource Action}">
        <Setter Property="Background" Value="{DynamicResource Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Primary}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryInk}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="ToolbarAction" TargetType="Button" BasedOn="{StaticResource Action}">
        <Setter Property="Background" Value="{DynamicResource HeaderControl}" />
        <Setter Property="Foreground" Value="{DynamicResource HeaderInk}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HeaderLine}" />
    </Style>
    <Style x:Key="RepairAction" TargetType="Button" BasedOn="{StaticResource Action}">
        <Setter Property="Background" Value="{DynamicResource RepairFill}" />
        <Setter Property="Foreground" Value="{DynamicResource RepairInk}" />
        <Setter Property="BorderBrush" Value="{DynamicResource RepairLine}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <DockPanel>
                        <Path DockPanel.Dock="Left" Width="16" Height="16" Stretch="Uniform" Margin="0,0,7,0"
                              VerticalAlignment="Center" StrokeThickness="1.7" StrokeLineJoin="Round"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Data="M 16,3 L 12,7 L 9,6 L 8,3 L 12,0 C 8,-1 5,2 5,5 L 6,8 L 0,14 C -1,16 1,18 3,17 L 10,10 C 14,11 17,7 16,3 Z" />
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="LinkAction" TargetType="Button" BasedOn="{StaticResource Action}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="5,3" />
        <Setter Property="MinHeight" Value="27" />
    </Style>
    <Style x:Key="Field" TargetType="TextBox">
        <Setter Property="Padding" Value="11,5" />
        <Setter Property="MinHeight" Value="33" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="Background" Value="{DynamicResource FieldFill}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Ink}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource SelectionFill}" />
        <Setter Property="SelectionOpacity" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource FocusLine}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ToolTip">
        <Setter Property="FontSize" Value="{DynamicResource Font13}" />
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    </Style>
    <Style TargetType="ContextMenu">
        <Setter Property="FontSize" Value="{DynamicResource Font16}" />
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" Padding="3">
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="Padding" Value="9,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid>
                        <Border x:Name="Item" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                        </Border>
                        <Border x:Name="HighlightMarker" Style="{StaticResource ItemHighlightMarker}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Item" Property="Background" Value="{DynamicResource Selected}" />
                            <Setter TargetName="HighlightMarker" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
