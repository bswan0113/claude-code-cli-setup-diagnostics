<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:String x:Key="ProfileStripLabel">アカウントプロファイル</sys:String>
    <sys:String x:Key="ProfileDefault">既定のアカウント</sys:String>
    <sys:String x:Key="ProfileCurrent">現在のプロファイル</sys:String>
    <sys:String x:Key="ProfileAdd">アカウントプロファイルを追加</sys:String>
    <sys:String x:Key="ProfileLogin">ログイン</sys:String>
    <sys:String x:Key="ProfileAddHint">タブに表示する名前を入力してください。作成すると新しいプロファイルに切り替わり、Claude Code の公式ログイン手順が開きます。ブラウザーで使用するアカウントを選んでください。</sys:String>
    <sys:String x:Key="ProfileLabel">タブの名前</sys:String>
    <sys:String x:Key="ProfileCreate">作成してログイン</sys:String>
    <sys:String x:Key="ProfileCancel">キャンセル</sys:String>
    <sys:String x:Key="ProfileListFailed">アカウントプロファイルを読み取れませんでした。ランチャーのローカル設定にアクセスできるか確認してください。</sys:String>
    <sys:String x:Key="ProfileCreateFailed">プロファイルを作成できませんでした。タブの名前とローカル設定フォルダーのアクセス権限を確認してください。</sys:String>
    <sys:String x:Key="ProfileSwitchFailed">選択したプロファイルを開けませんでした。現在のプロファイルは開いたままです。</sys:String>
    <sys:String x:Key="ProfileBusy">進行中の操作やターミナルの起動が終わってからやり直してください。</sys:String>
    <sys:String x:Key="ProfileSigningIn">PowerShell とブラウザーで Claude Code にログインしてください。</sys:String>
    <sys:String x:Key="ProfileLoginDone">現在のプロファイルでログインを確認しました。</sys:String>
    <sys:String x:Key="ProfileLoginCanceled">ログインを確認できませんでした。このタブのログインボタンからやり直してください。</sys:String>
    <sys:String x:Key="ProfileInvalidName">タブ名は 80 文字以内で、制御文字は使用できません。</sys:String>
    <sys:String x:Key="ProfileSwitching">選択したプロファイルを開いています…</sys:String>
    <sys:String x:Key="ProfileDuplicateName">このタブ名はすでに使われています。別の名前を入力してください。</sys:String>
</ResourceDictionary>
