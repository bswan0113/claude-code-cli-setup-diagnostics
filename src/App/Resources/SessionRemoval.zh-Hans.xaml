<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:String x:Key="SessionTrashActions">更多操作</sys:String>
    <sys:String x:Key="SessionTrashMove">将会话移到回收站…</sys:String>
    <sys:String x:Key="SessionTrashProject">从启动器移除项目…</sys:String>
    <sys:String x:Key="SessionTrashManageShort">管理</sys:String>
    <sys:String x:Key="SessionTrashManage">管理项目和会话</sys:String>
    <sys:String x:Key="SessionTrashSelectTab">项目和会话</sys:String>
    <sys:String x:Key="SessionTrashTitle">启动器回收站</sys:String>
    <sys:String x:Key="SessionTrashSelectionHint">勾选项目会选中该文件夹中保存的全部会话。展开项目可以逐个勾选。此列表包含启动器搜索隐藏的结果。</sys:String>
    <sys:String x:Key="SessionTrashProjectLine">{0} · {1} 个会话</sys:String>
    <sys:String x:Key="SessionTrashReviewCount">{0} 个项目 · {1} 个会话</sys:String>
    <sys:String x:Key="SessionTrashRecoveryGroup">需要恢复 · {0} 个项目 · {1} 个会话</sys:String>
    <sys:String x:Key="SessionTrashScope">要把选中的本地会话记录移到启动器回收站吗？稍后可在这里恢复。项目文件、独立的子代理日志、提示词历史和云端数据会保留。</sys:String>
    <sys:String x:Key="SessionTrashProjectScope">要从启动器移除选中的项目，并将其文件夹中的本地会话记录和单独勾选的会话移到启动器回收站吗？工作文件夹和文件会保留。作为独立项目列出的子文件夹只有勾选后才会一起移除。</sys:String>
    <sys:String x:Key="SessionTrashReview">核对移除项目</sys:String>
    <sys:String x:Key="SessionTrashConfirm">移到回收站</sys:String>
    <sys:String x:Key="SessionTrashRestore">恢复所选项</sys:String>
    <sys:String x:Key="SessionTrashRestoreHint">恢复到原来的位置。成组移除的项目会一起恢复，不会覆盖已有文件。</sys:String>
    <sys:String x:Key="SessionTrashAttention">检查所选项</sys:String>
    <sys:String x:Key="SessionTrashActive">所选会话或项目已在终端中打开，或正在启动。关闭相关终端后重试。</sys:String>
    <sys:String x:Key="SessionTrashConflict">会话 ID 或目标路径已被占用。请检查当前列表。</sys:String>
    <sys:String x:Key="SessionTrashChanged">所选记录已发生变化。请重新打开列表并核对。</sys:String>
    <sys:String x:Key="SessionTrashUnavailable">无法完成操作。请检查本地记录和启动器回收站的访问权限。</sys:String>
    <sys:String x:Key="SessionTrashRemoved">已移到启动器回收站。</sys:String>
    <sys:String x:Key="SessionTrashRestored">已恢复到启动器。</sys:String>
    <sys:String x:Key="SessionTrashLoading">正在读取本地记录…</sys:String>
    <sys:String x:Key="SessionTrashEmpty">启动器回收站为空。</sys:String>
    <sys:String x:Key="SessionTrashCancel">取消</sys:String>
    <sys:String x:Key="SessionTrashClose">关闭</sys:String>
</ResourceDictionary>
