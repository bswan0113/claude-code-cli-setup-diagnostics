<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:String x:Key="CheckInstallBinaryVerifiedTitle">Claude Code 실행 파일 정상</sys:String>
    <sys:String x:Key="CheckInstallBinaryVerifiedCause">Anthropic 서명과 실제 버전 응답을 확인했습니다.</sys:String>
    <sys:String x:Key="CheckInstallBinaryVerifiedSolution">이 실행 파일은 그대로 사용하세요.</sys:String>
    <sys:String x:Key="CheckInstallBinaryUnknownTitle">실행 파일 상태 확인 불가</sys:String>
    <sys:String x:Key="CheckInstallBinaryUnknownCause">파일을 읽거나 실행 상태를 확인하지 못했습니다.</sys:String>
    <sys:String x:Key="CheckInstallBinaryUnknownSolution">파일과 경로에 접근할 수 있는지 확인한 뒤 다시 검사하세요.</sys:String>
