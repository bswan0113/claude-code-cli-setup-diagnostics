    <sys:String x:Key="FixEnableUserClaudeUpdater">Clear the user's update block</sys:String>
    <sys:String x:Key="CheckInstallUpdaterUserFlagTitle">This account has automatic updates turned off</sys:String>
    <sys:String x:Key="CheckInstallUpdaterUserFlagCause">The user environment contains DISABLE_AUTOUPDATER.</sys:String>
    <sys:String x:Key="CheckInstallUpdaterUserFlagSolution">Remove the flag from this account to allow updates. Administrator policies still apply.</sys:String>
    <sys:String x:Key="UndoSettingsQuestion">Restore the original file, including its JSON error? This is available only while the repaired file and the saved original match this repair.</sys:String>
    <sys:String x:Key="HistoryActionRestoreSettingsBackup">Repair settings file</sys:String>
    <sys:String x:Key="HistoryUndoAction">Undo · {0}</sys:String>
    <sys:String x:Key="HistoryUnreadable">Could not read this record</sys:String>
    <sys:String x:Key="HistoryOnly">History only</sys:String>
