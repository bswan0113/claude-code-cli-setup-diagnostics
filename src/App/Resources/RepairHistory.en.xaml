<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:String x:Key="RepairHistoryHeading">Repair history</sys:String>
    <sys:String x:Key="HistoryReading">Loading repair history…</sys:String>
    <sys:String x:Key="HistoryEmptyList">No repairs recorded yet.</sys:String>
    <sys:String x:Key="HistoryReadFailed">Could not read the repair history for this Windows account.</sys:String>
    <sys:String x:Key="RecordedRepair">Repair</sys:String>
    <sys:String x:Key="HistoryPending">Completion unconfirmed</sys:String>
    <sys:String x:Key="HistoryApplied">Completed</sys:String>
    <sys:String x:Key="HistoryFailed">Did not complete</sys:String>
    <sys:String x:Key="HistoryUndoing">Undo completion unconfirmed</sys:String>
    <sys:String x:Key="HistoryUndone">Undone</sys:String>
    <sys:String x:Key="HistoryUndoFailed">Could not undo</sys:String>
    <sys:String x:Key="HistoryUnknown">Status unknown</sys:String>
    <sys:String x:Key="UndoRepair">Undo this change</sys:String>
    <sys:String x:Key="UndoRepairQuestion">Restore the previous value or package version? The launcher first checks whether the change still matches its record.</sys:String>
    <sys:String x:Key="StartLogin">Sign in</sys:String>
    <sys:String x:Key="PreviewSettings">Review changes</sys:String>
    <sys:String x:Key="FixClaudeLogin">Sign in to Claude Code</sys:String>
    <sys:String x:Key="FixEnableClaudeUpdater">Restore previous update setting</sys:String>
    <sys:String x:Key="CheckInstallUpdaterDisabledOwnedTitle">The launcher turned off automatic updates</sys:String>
