    <sys:String x:Key="Verifying">Verifying the current setup…</sys:String>
    <sys:String x:Key="TerminalPending">PowerShell is opening or in use.</sys:String>
    <sys:String x:Key="TerminalExited">The Claude Code session ended.</sys:String>
    <sys:String x:Key="TerminalCanceled">The terminal session was canceled.</sys:String>
    <sys:String x:Key="TerminalUnknown">The launcher could not verify how the terminal session ended.</sys:String>
    <sys:String x:Key="TerminalFailed">The terminal reported a launch problem.</sys:String>
    <sys:String x:Key="LoginCopied">The sign-in command was copied.</sys:String>
    <sys:String x:Key="SummaryCopied">The diagnostic summary was copied.</sys:String>
    <sys:String x:Key="CopyFailed">Could not copy to the clipboard. Try again.</sys:String>
    <sys:String x:Key="HelpFailed">Your browser could not be opened.</sys:String>
    <sys:String x:Key="LanguageSaveFailed">The display language changed, but the preference could not be saved.</sys:String>
    <sys:String x:Key="SessionsTitle">Recent conversations</sys:String>
    <sys:String x:Key="SessionsLoading">Loading recent conversations…</sys:String>
    <sys:String x:Key="SessionsEmpty">No saved conversations yet.</sys:String>
    <sys:String x:Key="SessionsEmptyFolder">No saved conversations for this folder.</sys:String>
    <sys:String x:Key="SessionScopeFolder">This folder</sys:String>
    <sys:String x:Key="SessionScopeAll">All folders</sys:String>
    <sys:String x:Key="ShowAllSessions">Show all</sys:String>
    <sys:String x:Key="ShowFolderSessions">Show this folder</sys:String>
    <sys:String x:Key="SessionsPartial">Some conversations could not be read. Use the CLI picker to look for them in a folder.</sys:String>
    <sys:String x:Key="SessionResumeUnavailable">Use the CLI picker to look for the conversation in this folder.</sys:String>
    <sys:String x:Key="SessionPicker">Choose a conversation in CLI</sys:String>
    <sys:String x:Key="SessionFallbackRunning">Opening the CLI conversation picker in the selected folder…</sys:String>
    <sys:String x:Key="ResumeIntent">Continue the selected conversation</sys:String>
    <sys:String x:Key="PickerIntent">Open the CLI conversation picker</sys:String>
    <sys:String x:Key="CliExitedWithErrorTitle">Claude Code exited with an error</sys:String>
    <sys:String x:Key="CliExitedWithErrorBody">Check setup again to investigate, or read the message in PowerShell.</sys:String>
    <sys:String x:Key="EvidenceRepairLockUnavailable">Could not lock setup changes for this Windows account.</sys:String>
    <sys:String x:Key="EvidenceRepairInProgress">Another launcher window is applying setup changes.</sys:String>
    <sys:String x:Key="EvidenceAccessDenied">Windows denied access.</sys:String>
    <sys:String x:Key="EvidenceEnvironmentCheckFailed">Could not check the PowerShell environment.</sys:String>
    <sys:String x:Key="EvidenceCommandLookupFailed">PowerShell could not look up the claude command.</sys:String>
    <sys:String x:Key="EvidenceUnsupportedCommandType">PowerShell found an unsupported command type.</sys:String>
    <sys:String x:Key="EvidenceSignatureCheckFailed">Could not check the executable signature.</sys:String>
    <sys:String x:Key="EvidenceSignatureUnverified">The executable signature could not be verified.</sys:String>
    <sys:String x:Key="EvidenceVersionCheckFailed">The CLI did not return a verified version.</sys:String>
    <sys:String x:Key="EvidenceAuthStatusUnverified">The CLI sign-in status could not be verified.</sys:String>
    <sys:String x:Key="EvidencePathEntryUnsupported">This directory cannot be added to PATH by the launcher.</sys:String>
    <sys:String x:Key="EvidencePathTargetChanged">PowerShell resolved the command to a different directory.</sys:String>
    <sys:String x:Key="EvidenceUserPathChanged">The saved user PATH changed during repair. Check again before retrying.</sys:String>
    <sys:String x:Key="EvidencePathVerificationFailed">The command still could not be verified after updating PATH.</sys:String>
    <sys:String x:Key="EvidenceWinGetUnavailable">WinGet was not found at the expected location.</sys:String>
    <sys:String x:Key="EvidenceWinGetStartFailed">WinGet could not be started.</sys:String>
    <sys:String x:Key="EvidenceWinGetTimeoutTerminationUnverified">WinGet did not finish in time. Check whether it is still running before retrying.</sys:String>
    <sys:String x:Key="EvidenceWinGetTimeout">WinGet did not finish in time. Check the installation state before retrying.</sys:String>
    <sys:String x:Key="EvidenceWinGetVerificationFailed">WinGet finished, but the launcher still could not find Claude Code.</sys:String>
    <sys:String x:Key="EvidenceWinGetPackageConsentRequired">Review the package agreement by running the command below in PowerShell.</sys:String>
    <sys:String x:Key="EvidenceWinGetSourceConsentRequired">Review the WinGet source agreement by running the command below in PowerShell.</sys:String>
    <sys:String x:Key="EvidenceWinGetInstallFailed">WinGet reported an installation error.</sys:String>
    <sys:String x:Key="SessionsPartialWithFolders">Some conversations could not be read. Select a folder below to open its CLI conversation list.</sys:String>
    <sys:String x:Key="EvidenceWinGetAlreadyRunning">WinGet is running in this Windows session. Wait for it to finish, then check again.</sys:String>
    <sys:String x:Key="EvidenceWorkingFolderUnavailable">PowerShell could not open the selected folder.</sys:String>
    <sys:String x:Key="EvidenceInstallationFootprintFound">Files or registration from a previous installation were found. The launcher could not confirm that Claude Code runs.</sys:String>
    <sys:String x:Key="EvidencePowerShellStartFailed">PowerShell could not start the check.</sys:String>
    <sys:String x:Key="EvidencePowerShellTimeout">The PowerShell check did not finish in time.</sys:String>
    <sys:String x:Key="EvidencePowerShellExitFailed">PowerShell exited with an error during the check.</sys:String>
    <sys:String x:Key="EvidencePowerShellOutputInvalid">The launcher could not read the PowerShell check result.</sys:String>
    <sys:String x:Key="EvidencePowerShellProbeFailed">The PowerShell check could not finish.</sys:String>
</ResourceDictionary>
