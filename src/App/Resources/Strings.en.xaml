<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:String x:Key="AppTitle">Claude Code Launcher</sys:String>
    <sys:String x:Key="AppSubtitle">Open a folder in Claude Code or fix a setup problem.</sys:String>
    <sys:String x:Key="LanguageLabel">Display language</sys:String>
    <sys:String x:Key="OpenFolderTitle">Open a folder</sys:String>
    <sys:String x:Key="OpenFolderBody">Enter a full folder path or browse on this PC.</sys:String>
    <sys:String x:Key="FolderLabel">Project folder</sys:String>
    <sys:String x:Key="BrowseFolder">Browse…</sys:String>
    <sys:String x:Key="OpenFolder">Start a new conversation</sys:String>
    <sys:String x:Key="RecentTitle">Recent folders</sys:String>
    <sys:String x:Key="HistoryLoading">Loading recent folders…</sys:String>
    <sys:String x:Key="HistoryEmpty">Folders you open in Claude Code will appear here.</sys:String>
    <sys:String x:Key="HistoryUnavailable">Recent folders could not be loaded. Enter a path or browse for a folder.</sys:String>
    <sys:String x:Key="SetupTitle">Setup and repair</sys:String>
    <sys:String x:Key="SetupBody">Check this PC before installing Claude Code or when it will not start.</sys:String>
    <sys:String x:Key="CheckSetup">Check setup</sys:String>
    <sys:String x:Key="CheckAgain">Check again</sys:String>
    <sys:String x:Key="CheckAfterLogin">Check after signing in</sys:String>
    <sys:String x:Key="CheckLoginAndOpen">Verify sign-in and open here</sys:String>
    <sys:String x:Key="TargetFolder">Selected folder</sys:String>
    <sys:String x:Key="ResultDetailLabel">Details</sys:String>
    <sys:String x:Key="CopyLoginCommand">Copy sign-in command</sys:String>
    <sys:String x:Key="CopySummary">Copy summary</sys:String>
    <sys:String x:Key="OfficialHelp">Official help</sys:String>
    <sys:String x:Key="Install">Install Claude Code</sys:String>
    <sys:String x:Key="InstallAndOpen">Install and open here</sys:String>
    <sys:String x:Key="RepairPath">Add to user PATH</sys:String>
    <sys:String x:Key="RepairPathAndOpen">Fix PATH and open here</sys:String>
    <sys:String x:Key="RefreshPath">Refresh PATH</sys:String>
    <sys:String x:Key="RefreshPathAndOpen">Refresh PATH and open here</sys:String>
    <sys:String x:Key="ReadyTitle">Claude Code is ready</sys:String>
    <sys:String x:Key="ReadyBody">Open a folder to start using Claude Code.</sys:String>
    <sys:String x:Key="MissingTitle">Claude Code was not found</sys:String>
    <sys:String x:Key="MissingBody">Claude Code can be installed for your Windows account from the official WinGet package (Anthropic.ClaudeCode).</sys:String>
    <sys:String x:Key="PathMissingTitle">Claude Code is missing from PATH</sys:String>
    <sys:String x:Key="PathMissingBody">The executable works directly. Add its folder to your user PATH so PowerShell can find the claude command.</sys:String>
    <sys:String x:Key="StalePathTitle">The launcher is using an older PATH</sys:String>
    <sys:String x:Key="StalePathBody">Windows already has the Claude Code path. Reload it for this launcher and the PowerShell windows it opens.</sys:String>
    <sys:String x:Key="AuthRequiredTitle">Sign in to Claude Code</sys:String>
    <sys:String x:Key="AuthRequiredBody">Run claude auth login in PowerShell, or follow the instructions in the open Claude Code session. Then check again here.</sys:String>
    <sys:String x:Key="ConflictTitle">PowerShell may be finding a different command</sys:String>
    <sys:String x:Key="ConflictBody">Check for another installation, alias or function. Run Get-Command claude -All in PowerShell to see which entries it finds.</sys:String>
    <sys:String x:Key="UnknownTitle">The cause is still unclear</sys:String>
    <sys:String x:Key="UnknownBody">Check whether claude --version runs in your PowerShell, then check again here. If Windows blocks the command, ask your PC administrator.</sys:String>
    <sys:String x:Key="InvalidFolderTitle">Choose an accessible folder</sys:String>
    <sys:String x:Key="InvalidFolderBody">Check the full path or select another folder with Browse.</sys:String>
    <sys:String x:Key="RepairFailedTitle">Setup could not finish</sys:String>
    <sys:String x:Key="RepairFailedBody">Check again to see the current state. If WinGet is unavailable or blocked, follow the official setup instructions.</sys:String>
    <sys:String x:Key="LaunchFailedTitle">Claude Code could not start</sys:String>
    <sys:String x:Key="LaunchFailedBody">Setup checks passed. Open PowerShell in this folder and run claude to see any message from the terminal.</sys:String>
    <sys:String x:Key="RetryFailedTitle">Claude Code still could not start</sys:String>
    <sys:String x:Key="RetryFailedBody">Check the current setup or open PowerShell in this folder to read the error.</sys:String>
    <sys:String x:Key="ExitCode">Exit code {0}</sys:String>
    <sys:String x:Key="Checking">Checking Claude Code setup…</sys:String>
