<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:String x:Key="SessionTrashActions">その他の操作</sys:String>
    <sys:String x:Key="SessionTrashMove">セッションをゴミ箱に移動…</sys:String>
    <sys:String x:Key="SessionTrashProject">ランチャーからプロジェクトを削除…</sys:String>
    <sys:String x:Key="SessionTrashManageShort">管理</sys:String>
    <sys:String x:Key="SessionTrashManage">プロジェクトとセッションの管理</sys:String>
    <sys:String x:Key="SessionTrashSelectTab">プロジェクトとセッション</sys:String>
    <sys:String x:Key="SessionTrashTitle">ランチャーのゴミ箱</sys:String>
    <sys:String x:Key="SessionTrashSelectionHint">プロジェクトにチェックを入れると、そのフォルダーの保存済みセッションをすべて選択します。個別に選ぶにはプロジェクトを展開してください。ランチャーの検索で非表示の項目も表示します。</sys:String>
    <sys:String x:Key="SessionTrashProjectLine">{0} · セッション {1} 件</sys:String>
    <sys:String x:Key="SessionTrashReviewCount">プロジェクト {0} 件 · セッション {1} 件</sys:String>
    <sys:String x:Key="SessionTrashRecoveryGroup">復元が必要 · プロジェクト {0} 件 · セッション {1} 件</sys:String>
    <sys:String x:Key="SessionTrashScope">選択したローカルの会話記録をランチャーのゴミ箱に移動しますか？ 後でここから復元できます。作業ファイル、別のサブエージェントログ、プロンプト履歴、クラウドのデータは残ります。</sys:String>
    <sys:String x:Key="SessionTrashProjectScope">選択したプロジェクトをランチャーから削除し、各フォルダーのローカル会話記録と個別に選んだセッションをゴミ箱に移動しますか？ 実際の作業フォルダーとファイルは残ります。別のプロジェクトとして表示されるサブフォルダーは、チェックを入れた場合のみ対象です。</sys:String>
    <sys:String x:Key="SessionTrashReview">削除する項目の確認</sys:String>
    <sys:String x:Key="SessionTrashConfirm">ゴミ箱に移動</sys:String>
    <sys:String x:Key="SessionTrashRestore">選択した項目を復元</sys:String>
    <sys:String x:Key="SessionTrashRestoreHint">選択した項目を元の場所に戻します。一括で移動した項目はまとめて復元します。同じ場所にあるファイルは上書きしません。</sys:String>
    <sys:String x:Key="SessionTrashAttention">選択内容の確認</sys:String>
    <sys:String x:Key="SessionTrashActive">選択したセッションまたはプロジェクトをターミナルで使用中か、起動中です。該当のターミナルを閉じてからやり直してください。</sys:String>
    <sys:String x:Key="SessionTrashConflict">セッション ID または移動先がすでに使われています。一覧を確認してください。</sys:String>
    <sys:String x:Key="SessionTrashChanged">選択した記録が変わりました。一覧を開き直して確認してください。</sys:String>
    <sys:String x:Key="SessionTrashUnavailable">操作を完了できませんでした。ローカルの記録とランチャーのゴミ箱にアクセスできるか確認してください。</sys:String>
    <sys:String x:Key="SessionTrashRemoved">ランチャーのゴミ箱に移動しました。</sys:String>
    <sys:String x:Key="SessionTrashRestored">ランチャーに復元しました。</sys:String>
    <sys:String x:Key="SessionTrashLoading">ローカルの記録を読み込み中…</sys:String>
    <sys:String x:Key="SessionTrashEmpty">ランチャーのゴミ箱は空です。</sys:String>
    <sys:String x:Key="SessionTrashCancel">キャンセル</sys:String>
    <sys:String x:Key="SessionTrashClose">閉じる</sys:String>
</ResourceDictionary>
