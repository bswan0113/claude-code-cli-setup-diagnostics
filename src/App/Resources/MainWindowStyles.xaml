<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="LauncherStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <Style x:Key="DashboardTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionLabel}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSidebar, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                <Setter Property="FontSize" Value="{DynamicResource Font19}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="ListAction" TargetType="Button" BasedOn="{StaticResource LinkAction}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    </Style>
    <Style x:Key="ToolbarCombo" TargetType="ComboBox">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Foreground" Value="{DynamicResource HeaderInk}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
                    <Setter Property="Background" Value="{DynamicResource Surface}" />
                    <Setter Property="Padding" Value="9,5" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Grid>
                                    <Border x:Name="Item" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <Border x:Name="HighlightMarker" Style="{StaticResource ItemHighlightMarker}" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Item" Property="Background" Value="{DynamicResource FolderExpanded}" />
                                    </Trigger>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="Item" Property="Background" Value="{DynamicResource Selected}" />
                                        <Setter TargetName="HighlightMarker" Property="Visibility" Value="Visible" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      ClickMode="Press" Background="{DynamicResource HeaderControl}" BorderBrush="{DynamicResource HeaderLine}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="1" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <DockPanel IsHitTestVisible="False" Margin="10,0">
                            <TextBlock DockPanel.Dock="Right" Text="▾" Foreground="{DynamicResource HeaderInk}" VerticalAlignment="Center" />
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" VerticalAlignment="Center" />
                        </DockPanel>
                        <Control x:Name="KeyboardFocusRing" Template="{StaticResource KeyboardFocusOutline}"
                                 Focusable="False" IsHitTestVisible="False" Visibility="Hidden" />
                        <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                    MinWidth="{TemplateBinding ActualWidth}" TextElement.Foreground="{DynamicResource Ink}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="KeyboardFocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="MainOnlyText" TargetType="TextBlock">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSidebar, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="ListTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Font18}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSidebar, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                <Setter Property="FontSize" Value="{DynamicResource Font14}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="FolderNameText" TargetType="TextBlock" BasedOn="{StaticResource ListTitle}">
        <Setter Property="DockPanel.Dock" Value="Left" />
        <Setter Property="MaxWidth" Value="210" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSidebar, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                <Setter Property="DockPanel.Dock" Value="Top" />
                <Setter Property="MaxWidth" Value="Infinity" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="FolderPathText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Font14}" />
        <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        <Setter Property="Margin" Value="12,0,0,0" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSidebar, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                <Setter Property="FontSize" Value="{DynamicResource Font13}" />
                <Setter Property="Margin" Value="0,0,0,2" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="ItemSeparator" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource RowLine}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="4,3" />
        <Setter Property="MinHeight" Value="47" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSidebar, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                <Setter Property="MinHeight" Value="38" />
                <Setter Property="Padding" Value="3,1" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="RunningSeparator" TargetType="Border" BasedOn="{StaticResource ItemSeparator}">
        <Setter Property="MinHeight" Value="61" />
        <Setter Property="Padding" Value="4,4" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSidebar, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                <Setter Property="MinHeight" Value="48" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Margin" Value="0,0,0,2" />
                <Setter Property="Background" Value="{DynamicResource Surface}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="ActivityBadge" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource FolderFill}" />
        <Setter Property="Padding" Value="9,3" />
        <Setter Property="MinWidth" Value="105" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Activity}" Value="Working">
                <Setter Property="Background" Value="{DynamicResource WorkingFill}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Activity}" Value="Waiting">
                <Setter Property="Background" Value="{DynamicResource WaitingFill}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Activity}" Value="Approval">
                <Setter Property="Background" Value="{DynamicResource ApprovalFill}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Activity}" Value="Answer">
                <Setter Property="Background" Value="{DynamicResource AnswerFill}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSidebar, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Padding" Value="5,2" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="FolderHeader" TargetType="DockPanel">
        <Setter Property="MinHeight" Value="44" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSidebar, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                <Setter Property="MinHeight" Value="34" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="TreeSessionLine" TargetType="DockPanel">
        <Setter Property="MinHeight" Value="36" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSidebar, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                <Setter Property="MinHeight" Value="26" />
                <Setter Property="TextElement.FontSize" Value="{DynamicResource Font13}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="ActivityText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        <Setter Property="FontSize" Value="{DynamicResource Font13}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextAlignment" Value="Center" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Activity}" Value="Working">
                <Setter Property="Foreground" Value="{DynamicResource WorkingInk}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Activity}" Value="Waiting">
                <Setter Property="Foreground" Value="{DynamicResource WaitingInk}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Activity}" Value="Approval">
                <Setter Property="Foreground" Value="{DynamicResource ApprovalInk}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Activity}" Value="Answer">
                <Setter Property="Foreground" Value="{DynamicResource AnswerInk}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="TreeExpander" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent">
                        <TextBlock x:Name="Arrow" Text="▸" FontSize="{DynamicResource Font15}" Foreground="{DynamicResource Ink}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Arrow" Property="Text" Value="▾" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="HistoryItem" TargetType="TreeViewItem">
        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <StackPanel>
                        <Border x:Name="RowBorder" Background="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="ArrowColumn" Width="0" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ToggleButton x:Name="Expander" Style="{StaticResource TreeExpander}"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              Visibility="Collapsed" />
                                <ContentPresenter x:Name="PART_Header" Grid.Column="1" ContentSource="Header"
                                                  HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                                <Border x:Name="SelectionMarker" Grid.ColumnSpan="2" Style="{StaticResource ItemHighlightMarker}" />
                            </Grid>
                        </Border>
                        <Border x:Name="ChildBranch" Margin="35,0,0,0" BorderBrush="{DynamicResource Line}"
                                BorderThickness="1,0,0,0" Padding="16,1,0,2" Visibility="Collapsed">
                            <ItemsPresenter />
                        </Border>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasItems" Value="True">
                            <Setter TargetName="ArrowColumn" Property="Width" Value="34" />
                            <Setter TargetName="Expander" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource FolderFill}" />
                        </Trigger>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ChildBranch" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource FolderExpanded}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource Selected}" />
                            <Setter TargetName="SelectionMarker" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsSidebar, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                            <Setter TargetName="ChildBranch" Property="Margin" Value="14,0,0,0" />
                            <Setter TargetName="ChildBranch" Property="Padding" Value="5,1,0,1" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
