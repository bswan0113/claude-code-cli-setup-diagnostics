<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:String x:Key="CheckPolicyUnknownTitle">PowerShell policy check unavailable</sys:String>
    <sys:String x:Key="CheckPolicyUnknownCause">Windows PowerShell could not verify the effective policy or the npm script signature.</sys:String>
    <sys:String x:Key="CheckPolicyUnknownSolution">Run Get-ExecutionPolicy -List and check the script with Get-AuthenticodeSignature.</sys:String>
    <sys:String x:Key="CheckPolicyNativeTitle">Executable does not need a script policy change</sys:String>
    <sys:String x:Key="CheckPolicyNativeCause">PowerShell found an .exe. The script execution policy applies to scripts such as .ps1 files.</sys:String>
    <sys:String x:Key="CheckPolicyNativeSolution">Keep the current policy.</sys:String>
    <sys:String x:Key="CheckPolicyUnconfirmedTitle">Could not confirm a script policy conflict</sys:String>
    <sys:String x:Key="CheckPolicyUnconfirmedCause">The selected claude command does not match a recognized npm PowerShell launcher.</sys:String>
    <sys:String x:Key="CheckPolicyUnconfirmedSolution">Check Get-Command claude -All in the affected shell. Use an official native CLI for this launcher.</sys:String>
    <sys:String x:Key="CheckPolicyNpmAllowedTitle">npm script execution policy</sys:String>
    <sys:String x:Key="CheckPolicyNpmAllowedCause">The detected policy and file markings do not show a clear block for this npm script.</sys:String>
    <sys:String x:Key="CheckPolicyNpmAllowedSolution">If it fails, check the PowerShell error and Get-ExecutionPolicy -List.</sys:String>
    <sys:String x:Key="CheckPolicyGroupTitle">Group Policy manages script execution</sys:String>
    <sys:String x:Key="CheckPolicyGroupCause">MachinePolicy or UserPolicy takes priority over CurrentUser and blocks this npm script.</sys:String>
    <sys:String x:Key="CheckPolicyGroupSolution">Ask your administrator about the policy and the approved Claude Code installation method.</sys:String>
    <sys:String x:Key="CheckPolicyNpmManualTitle">Check the npm launcher manually</sys:String>
    <sys:String x:Key="CheckPolicyNpmManualCause">The selected script is blocked, and changing CurrentUser alone may leave that block in place.</sys:String>
    <sys:String x:Key="CheckPolicyNpmManualSolution">Check the session policy, source and signature. For this launcher, use an approved native CLI.</sys:String>
    <sys:String x:Key="CheckPolicyNpmBlockedTitle">PowerShell blocks the local npm script</sys:String>
    <sys:String x:Key="CheckPolicyNpmBlockedCause">The current policy blocks the identified local npm .ps1 launcher. RemoteSigned allows unsigned local scripts, which changes protection for other scripts run by this user as well.</sys:String>
    <sys:String x:Key="CheckPolicyNpmBlockedSolution">Use the native CLI for this launcher. Change to RemoteSigned only if you intend to run the trusted npm script in PowerShell.</sys:String>
    <sys:String x:Key="CheckEnvManagedTitle">Environment variable managed by policy</sys:String>
    <sys:String x:Key="CheckEnvManagedCause">A local Claude Code policy declares this variable.</sys:String>
    <sys:String x:Key="CheckEnvManagedSolution">Use /status to check the setting sources and ask your administrator about changes.</sys:String>
    <sys:String x:Key="CheckEnvUnsetTitle">Environment variable is unset</sys:String>
    <sys:String x:Key="CheckEnvUnsetCause">This variable is absent from the app process and saved Windows environment.</sys:String>
    <sys:String x:Key="CheckEnvUnsetSolution">Keep this state if you do not need a custom configuration. Check /status for Claude Code settings.</sys:String>
    <sys:String x:Key="CheckEnvApiKeyTitle">API key configured</sys:String>
    <sys:String x:Key="CheckEnvApiKeyCause">An approved API key can take priority over a subscription in interactive CLI sessions. It can also trigger API billing.</sys:String>
    <sys:String x:Key="CheckEnvApiKeySolution">Run /status to check authentication. If you no longer use this key, approve removal of the listed user variable.</sys:String>
    <sys:String x:Key="CheckEnvApiKeyManualTitle">Review the API key configuration</sys:String>
    <sys:String x:Key="CheckEnvApiKeyManualCause">An API key is present in the displayed scope. Managed, system or independent session settings require review.</sys:String>
    <sys:String x:Key="CheckEnvApiKeyManualSolution">Check /status and the displayed scope. Keep an intended key and ask the administrator about managed settings.</sys:String>
    <sys:String x:Key="CheckEnvAuthTokenTitle">Authentication token configured</sys:String>
    <sys:String x:Key="CheckEnvAuthTokenCause">Claude Code can use a configured token for API or gateway authentication.</sys:String>
    <sys:String x:Key="CheckEnvAuthTokenSolution">Check /status and your provider setup. Remove the listed user variable only if it is no longer needed.</sys:String>
    <sys:String x:Key="CheckEnvAuthTokenManualTitle">Review the authentication token</sys:String>
    <sys:String x:Key="CheckEnvAuthTokenManualCause">A token is present in the displayed scope. It may be required by your environment.</sys:String>
    <sys:String x:Key="CheckEnvAuthTokenManualSolution">Check /status and the source that sets the variable. Ask the administrator about managed settings.</sys:String>
    <sys:String x:Key="CheckEnvEndpointTitle">Custom API endpoint configured</sys:String>
    <sys:String x:Key="CheckEnvEndpointCause">A custom base URL can direct Claude Code requests to a different endpoint.</sys:String>
    <sys:String x:Key="CheckEnvEndpointSolution">Confirm your provider or organization setup before removing an old user override.</sys:String>
    <sys:String x:Key="CheckEnvEndpointManualTitle">Review the custom API endpoint</sys:String>
    <sys:String x:Key="CheckEnvEndpointManualCause">The displayed scope configures the endpoint. A gateway or provider may require it.</sys:String>
    <sys:String x:Key="CheckEnvEndpointManualSolution">Check your provider, local settings and organization policy. Ask the administrator about changes.</sys:String>
    <sys:String x:Key="CheckEnvCaFoundTitle">Custom CA file found</sys:String>
    <sys:String x:Key="CheckEnvCaFoundCause">The configured file exists. This check does not validate its certificate chain.</sys:String>
    <sys:String x:Key="CheckEnvCaFoundSolution">For a TLS error, ask IT to confirm the required PEM certificate and Windows trust store.</sys:String>
    <sys:String x:Key="CheckEnvCaMissingTitle">Custom CA file is missing</sys:String>
    <sys:String x:Key="CheckEnvCaMissingCause">The variable points to a missing path or a directory.</sys:String>
    <sys:String x:Key="CheckEnvCaMissingSolution">If a corporate proxy needs this CA, ask IT for the correct PEM path. Clear the listed user value only if it is obsolete.</sys:String>
    <sys:String x:Key="CheckEnvCaMissingManualTitle">Review the missing CA file</sys:String>
    <sys:String x:Key="CheckEnvCaMissingManualCause">The configured CA path could not be found in the displayed scope.</sys:String>
    <sys:String x:Key="CheckEnvCaMissingManualSolution">Ask IT for the correct PEM path or update the setting at its source.</sys:String>
    <sys:String x:Key="CheckEnvGitBashFoundTitle">Git Bash file found</sys:String>
    <sys:String x:Key="CheckEnvGitBashFoundCause">The configured shell file exists and has a supported name.</sys:String>
    <sys:String x:Key="CheckEnvGitBashFoundSolution">If Claude Code still cannot use it, review /status and Windows endpoint policy.</sys:String>
    <sys:String x:Key="CheckEnvGitBashInvalidTitle">Git Bash path needs attention</sys:String>
    <sys:String x:Key="CheckEnvGitBashInvalidCause">The configured path is missing or has an unsupported shell name.</sys:String>
    <sys:String x:Key="CheckEnvGitBashInvalidSolution">Use the detected Git Bash if shown, or clear the obsolete user override to restore automatic discovery.</sys:String>
    <sys:String x:Key="CheckEnvGitBashInvalidManualTitle">Review the Git Bash path manually</sys:String>
    <sys:String x:Key="CheckEnvGitBashInvalidManualCause">The configured path is missing or has an unsupported shell name in the displayed scope.</sys:String>
    <sys:String x:Key="CheckEnvGitBashInvalidManualSolution">Use where.exe git to find the intended installation. Check its bin\bash.exe and correct the setting at its source.</sys:String>
    <sys:String x:Key="CheckEnvPathUnverifiedTitle">Could not verify the configured file path</sys:String>
    <sys:String x:Key="CheckEnvPathUnverifiedCause">The path could not be safely resolved or inspected.</sys:String>
    <sys:String x:Key="CheckEnvPathUnverifiedSolution">Confirm that the variable points to a local file you can open. Check permissions and contact IT if needed.</sys:String>
    <sys:String x:Key="CheckGitFoundTitle">Git tooling found</sys:String>
    <sys:String x:Key="CheckGitFoundCause">PowerShell found git.exe or a Git Bash file at a standard installation location.</sys:String>
    <sys:String x:Key="CheckGitFoundSolution">Install or configure Git Bash if you need Claude Code's Bash tool.</sys:String>
    <sys:String x:Key="CheckGitNotFoundTitle">Git tooling not found</sys:String>
    <sys:String x:Key="CheckGitNotFoundCause">No Git command or standard Git Bash installation was found. Native Claude Code can use PowerShell.</sys:String>
    <sys:String x:Key="CheckGitNotFoundSolution">Install Git for Windows from git-scm.com only if you need Git or Bash.</sys:String>
    <sys:String x:Key="CheckGitUnknownTitle">Could not confirm Git availability</sys:String>
    <sys:String x:Key="CheckGitUnknownCause">The PowerShell command lookup did not complete and no standard Git Bash file was found.</sys:String>
    <sys:String x:Key="CheckGitUnknownSolution">Check Get-Command git.exe and your Git for Windows installation.</sys:String>
    <sys:String x:Key="CheckProxyConfiguredTitle">Proxy variable configured</sys:String>
    <sys:String x:Key="CheckProxyConfiguredCause">A proxy variable is present in the displayed scope. Its value is hidden.</sys:String>
    <sys:String x:Key="CheckProxyConfiguredSolution">Confirm the required proxy and exclusions with IT. Keep approved organization settings.</sys:String>
    <sys:String x:Key="CheckProxyUnsetTitle">No Windows proxy variable found</sys:String>
    <sys:String x:Key="CheckProxyUnsetCause">No listed proxy variable was found in the Windows environment. System proxy or Claude Code settings may still apply.</sys:String>
    <sys:String x:Key="CheckProxyUnsetSolution">Check Windows proxy settings and Claude Code /status if this network requires a proxy.</sys:String>
    <sys:String x:Key="CheckNetReachableTitle">Host returned an HTTP response</sys:String>
    <sys:String x:Key="CheckNetReachableCause">The host answered this unauthenticated request. Sign-in and model requests were not tested.</sys:String>
    <sys:String x:Key="CheckNetReachableSolution">If Claude Code still fails, check /status and the error from the actual request.</sys:String>
    <sys:String x:Key="CheckNetHttpWarningTitle">Host returned an HTTP warning</sys:String>
    <sys:String x:Key="CheckNetHttpWarningCause">The HTTP response indicates a possible access, proxy, rate-limit or service issue.</sys:String>
    <sys:String x:Key="CheckNetHttpWarningSolution">Check the reported HTTP status, your approved network and Claude Status, then test again.</sys:String>
    <sys:String x:Key="CheckNetDownloadReadyTitle">Download endpoint returned a version</sys:String>
    <sys:String x:Key="CheckNetDownloadReadyCause">The public endpoint returned a release version in the expected format.</sys:String>
    <sys:String x:Key="CheckNetDownloadReadySolution">Continue installation or update and verify the installed CLI version.</sys:String>
    <sys:String x:Key="CheckNetDownloadForbiddenTitle">Download endpoint returned HTTP 403</sys:String>
    <sys:String x:Key="CheckNetDownloadForbiddenCause">A network rule, proxy, regional requirement or service policy may have denied access.</sys:String>
    <sys:String x:Key="CheckNetDownloadForbiddenSolution">Check regional availability and ask IT whether downloads.claude.ai is allowed.</sys:String>
    <sys:String x:Key="CheckNetDownloadHtmlTitle">Download endpoint returned a web page</sys:String>
    <sys:String x:Key="CheckNetDownloadHtmlCause">The version request returned HTML. A sign-in page, proxy or network filter may have intercepted it.</sys:String>
    <sys:String x:Key="CheckNetDownloadHtmlSolution">Check the network sign-in and proxy settings, then repeat the test on an approved network.</sys:String>
    <sys:String x:Key="CheckNetDownloadUnexpectedTitle">Unexpected download response</sys:String>
    <sys:String x:Key="CheckNetDownloadUnexpectedCause">The endpoint did not return a release version in the expected format.</sys:String>
    <sys:String x:Key="CheckNetDownloadUnexpectedSolution">Check the HTTP status, approved proxy and Claude Status before trying again.</sys:String>
    <sys:String x:Key="CheckNetRegionTitle">Download response reports a regional restriction</sys:String>
    <sys:String x:Key="CheckNetRegionCause">The response body says the download is unavailable in the current region.</sys:String>
    <sys:String x:Key="CheckNetRegionSolution">Check Anthropic's supported regions and confirm your network location with IT.</sys:String>
    <sys:String x:Key="CheckNetTimeoutTitle">Network check timed out</sys:String>
    <sys:String x:Key="CheckNetTimeoutCause">The request did not finish within the time shown.</sys:String>
    <sys:String x:Key="CheckNetTimeoutSolution">Check your connection and approved proxy, then run the test again.</sys:String>
    <sys:String x:Key="CheckNetTlsTitle">TLS verification failed</sys:String>
    <sys:String x:Key="CheckNetTlsCause">Windows could not establish a trusted TLS connection to the host.</sys:String>
    <sys:String x:Key="CheckNetTlsSolution">Confirm system time and the approved corporate CA with IT. Claude Code may also require NODE_EXTRA_CA_CERTS.</sys:String>
    <sys:String x:Key="CheckNetDnsTitle">Host name could not be resolved</sys:String>
    <sys:String x:Key="CheckNetDnsCause">The network stack could not resolve the host name.</sys:String>
    <sys:String x:Key="CheckNetDnsSolution">Check DNS, connectivity and the approved network configuration.</sys:String>
    <sys:String x:Key="CheckNetProxyTitle">Proxy tunnel failed</sys:String>
    <sys:String x:Key="CheckNetProxyCause">The network stack could not open the proxy tunnel to the host.</sys:String>
    <sys:String x:Key="CheckNetProxySolution">Check the approved proxy and authentication setup with IT.</sys:String>
    <sys:String x:Key="CheckNetTransportTitle">Network connection failed</sys:String>
    <sys:String x:Key="CheckNetTransportCause">The request ended before this check could obtain a usable response.</sys:String>
    <sys:String x:Key="CheckNetTransportSolution">Check your connection, firewall and approved proxy, then repeat the check.</sys:String>
    <sys:String x:Key="FixUserRemoteSigned">Change the current user's policy to RemoteSigned</sys:String>
    <sys:String x:Key="FixClearUserVariable">Remove the listed user environment variable</sys:String>
    <sys:String x:Key="FixSetUserGitBash">Set the user Git Bash path to the file shown</sys:String>
</ResourceDictionary>
