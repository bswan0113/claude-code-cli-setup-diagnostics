<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:String x:Key="CheckPolicyUnknownTitle">无法检查 PowerShell 执行策略</sys:String>
    <sys:String x:Key="CheckPolicyUnknownCause">Windows PowerShell 无法验证当前生效的执行策略或 npm 脚本签名。</sys:String>
    <sys:String x:Key="CheckPolicyUnknownSolution">运行 Get-ExecutionPolicy -List 检查策略，并用 Get-AuthenticodeSignature 验证脚本签名。</sys:String>
    <sys:String x:Key="CheckPolicyNativeTitle">可执行文件无需更改脚本策略</sys:String>
    <sys:String x:Key="CheckPolicyNativeCause">PowerShell 找到了 .exe。执行策略适用于 .ps1 等脚本。</sys:String>
    <sys:String x:Key="CheckPolicyNativeSolution">保留现有策略即可。</sys:String>
    <sys:String x:Key="CheckPolicyUnconfirmedTitle">未能确认脚本策略冲突</sys:String>
    <sys:String x:Key="CheckPolicyUnconfirmedCause">当前的 claude 命令与可识别的 npm PowerShell 脚本不匹配。</sys:String>
    <sys:String x:Key="CheckPolicyUnconfirmedSolution">在出问题的 PowerShell 中运行 Get-Command claude -All。本启动器使用官方原生 CLI。</sys:String>
    <sys:String x:Key="CheckPolicyNpmAllowedTitle">npm 脚本执行策略</sys:String>
    <sys:String x:Key="CheckPolicyNpmAllowedCause">检查的策略和文件信息中没有发现会阻止这个 npm 脚本的条件。</sys:String>
    <sys:String x:Key="CheckPolicyNpmAllowedSolution">如果运行失败，请查看 PowerShell 错误和 Get-ExecutionPolicy -List 的输出。</sys:String>
    <sys:String x:Key="CheckPolicyGroupTitle">组策略阻止脚本运行</sys:String>
    <sys:String x:Key="CheckPolicyGroupCause">MachinePolicy 或 UserPolicy 优先于 CurrentUser，阻止了这个 npm 脚本。</sys:String>
    <sys:String x:Key="CheckPolicyGroupSolution">向管理员确认执行策略和组织批准的 Claude Code 安装方式。</sys:String>
    <sys:String x:Key="CheckPolicyNpmManualTitle">手动检查 npm 脚本</sys:String>
    <sys:String x:Key="CheckPolicyNpmManualCause">存在阻止脚本运行的条件，只更改 CurrentUser 可能无法解除限制。</sys:String>
    <sys:String x:Key="CheckPolicyNpmManualSolution">检查会话策略、脚本来源和签名。在本启动器中使用获准的原生 CLI。</sys:String>
    <sys:String x:Key="CheckPolicyNpmBlockedTitle">策略阻止本地 npm 脚本</sys:String>
    <sys:String x:Key="CheckPolicyNpmBlockedCause">当前策略阻止已识别的本地 npm .ps1。RemoteSigned 也会允许此用户运行其他未签名的本地脚本。</sys:String>
    <sys:String x:Key="CheckPolicyNpmBlockedSolution">本启动器使用原生 CLI。确实需要在 PowerShell 中运行可信 npm 脚本时，再批准更改。</sys:String>
    <sys:String x:Key="CheckEnvManagedTitle">环境变量由策略管理</sys:String>
    <sys:String x:Key="CheckEnvManagedCause">本地 Claude Code 策略指定了此变量。</sys:String>
    <sys:String x:Key="CheckEnvManagedSolution">通过 /status 确认设置来源。如需更改，请联系管理员。</sys:String>
    <sys:String x:Key="CheckEnvUnsetTitle">环境变量未设置</sys:String>
    <sys:String x:Key="CheckEnvUnsetCause">应用进程和 Windows 保存的环境中都没有此变量。</sys:String>
    <sys:String x:Key="CheckEnvUnsetSolution">不需要自定义设置时可保留现状。可通过 /status 查看 Claude Code 的设置。</sys:String>
    <sys:String x:Key="CheckEnvApiKeyTitle">检测到 API 密钥</sys:String>
    <sys:String x:Key="CheckEnvApiKeyCause">在交互式 CLI 中，已批准的 API 密钥可能优先用于认证，并产生 API 费用。</sys:String>
    <sys:String x:Key="CheckEnvApiKeySolution">在 /status 中确认认证方式。密钥已停用时，再批准删除所列用户变量。</sys:String>
    <sys:String x:Key="CheckEnvApiKeyManualTitle">检查 API 密钥设置</sys:String>
    <sys:String x:Key="CheckEnvApiKeyManualCause">所列范围内设有 API 密钥。系统、组织或独立会话设置需要确认来源。</sys:String>
    <sys:String x:Key="CheckEnvApiKeyManualSolution">查看 /status 和所列范围。保留仍在使用的密钥，管理设置请咨询管理员。</sys:String>
    <sys:String x:Key="CheckEnvAuthTokenTitle">检测到身份验证令牌</sys:String>
    <sys:String x:Key="CheckEnvAuthTokenCause">Claude Code 可能使用该令牌进行 API 或网关认证。</sys:String>
    <sys:String x:Key="CheckEnvAuthTokenSolution">查看 /status 和提供商设置。只删除不再需要的用户变量。</sys:String>
    <sys:String x:Key="CheckEnvAuthTokenManualTitle">检查身份验证令牌</sys:String>
    <sys:String x:Key="CheckEnvAuthTokenManualCause">所列范围内设有令牌，当前环境可能需要它。</sys:String>
    <sys:String x:Key="CheckEnvAuthTokenManualSolution">查看 /status 和变量设置来源。管理设置请咨询管理员。</sys:String>
    <sys:String x:Key="CheckEnvEndpointTitle">设置了自定义 API 端点</sys:String>
    <sys:String x:Key="CheckEnvEndpointCause">自定义地址可能将 Claude Code 请求发送到其他端点。</sys:String>
    <sys:String x:Key="CheckEnvEndpointSolution">先确认提供商或组织使用的地址，再删除不再需要的用户设置。</sys:String>
    <sys:String x:Key="CheckEnvEndpointManualTitle">检查自定义 API 端点</sys:String>
    <sys:String x:Key="CheckEnvEndpointManualCause">所列范围指定了连接地址，网关或提供商可能需要此设置。</sys:String>
    <sys:String x:Key="CheckEnvEndpointManualSolution">检查提供商和组织配置。管理设置请咨询管理员。</sys:String>
    <sys:String x:Key="CheckEnvCaFoundTitle">找到了自定义 CA 文件</sys:String>
    <sys:String x:Key="CheckEnvCaFoundCause">指定的文件存在。证书链的有效性需要另行验证。</sys:String>
    <sys:String x:Key="CheckEnvCaFoundSolution">若发生 TLS 错误，请向 IT 确认所需的 PEM 证书和 Windows 信任存储。</sys:String>
    <sys:String x:Key="CheckEnvCaMissingTitle">找不到自定义 CA 文件</sys:String>
    <sys:String x:Key="CheckEnvCaMissingCause">变量指向的路径缺少文件，或者指向文件夹。</sys:String>
    <sys:String x:Key="CheckEnvCaMissingSolution">若公司代理需要此 CA，请向 IT 索取正确的 PEM 路径。只清除已废弃的用户设置。</sys:String>
    <sys:String x:Key="CheckEnvCaMissingManualTitle">手动检查 CA 文件路径</sys:String>
    <sys:String x:Key="CheckEnvCaMissingManualCause">找不到所列范围中指定的 CA 文件。</sys:String>
    <sys:String x:Key="CheckEnvCaMissingManualSolution">请向 IT 获取正确的 PEM 路径，或在原设置位置修正路径。</sys:String>
    <sys:String x:Key="CheckEnvGitBashFoundTitle">找到了 Git Bash 文件</sys:String>
    <sys:String x:Key="CheckEnvGitBashFoundCause">指定的 shell 文件存在，文件名受支持。</sys:String>
    <sys:String x:Key="CheckEnvGitBashFoundSolution">如果 Claude Code 仍无法调用它，请检查 /status 和 Windows 安全策略。</sys:String>
    <sys:String x:Key="CheckEnvGitBashInvalidTitle">检查 Git Bash 路径</sys:String>
    <sys:String x:Key="CheckEnvGitBashInvalidCause">指定路径没有文件，或 shell 文件名不受支持。</sys:String>
    <sys:String x:Key="CheckEnvGitBashInvalidSolution">若检测到合适的 Git Bash，请使用显示的路径。删除旧的用户设置后，CLI 会重新检测。</sys:String>
    <sys:String x:Key="CheckEnvGitBashInvalidManualTitle">手动检查 Git Bash 路径</sys:String>
    <sys:String x:Key="CheckEnvGitBashInvalidManualCause">所列范围中配置的路径缺少文件，或 shell 文件名不受支持。</sys:String>
    <sys:String x:Key="CheckEnvGitBashInvalidManualSolution">使用 where.exe git 查找安装位置，确认 bin\bash.exe 后在原设置位置修改。</sys:String>
    <sys:String x:Key="CheckEnvPathUnverifiedTitle">无法验证所设文件路径</sys:String>
    <sys:String x:Key="CheckEnvPathUnverifiedCause">路径无法解析，或文件无法访问。</sys:String>
    <sys:String x:Key="CheckEnvPathUnverifiedSolution">确认变量指向能在本机打开的文件，并检查权限。组织管理的路径请咨询 IT。</sys:String>
    <sys:String x:Key="CheckGitFoundTitle">找到了 Git 工具</sys:String>
    <sys:String x:Key="CheckGitFoundCause">PowerShell 找到了 git.exe，或在标准安装位置检测到了 Git Bash 文件。</sys:String>
    <sys:String x:Key="CheckGitFoundSolution">如需使用 Claude Code 的 Bash 工具，请确认 Git Bash 的安装及路径。</sys:String>
    <sys:String x:Key="CheckGitNotFoundTitle">找不到 Git 工具</sys:String>
    <sys:String x:Key="CheckGitNotFoundCause">已检查 Git 命令和标准安装位置。原生 Claude Code 也可使用 PowerShell。</sys:String>
    <sys:String x:Key="CheckGitNotFoundSolution">需要 Git 或 Bash 时，可从 git-scm.com 安装 Git for Windows。</sys:String>
    <sys:String x:Key="CheckGitUnknownTitle">无法确认 Git 是否可用</sys:String>
    <sys:String x:Key="CheckGitUnknownCause">PowerShell 命令检查未完成，标准安装位置也没有 Git Bash 文件。</sys:String>
    <sys:String x:Key="CheckGitUnknownSolution">运行 Get-Command git.exe，并检查 Git for Windows 安装。</sys:String>
    <sys:String x:Key="CheckProxyConfiguredTitle">已设置代理环境变量</sys:String>
    <sys:String x:Key="CheckProxyConfiguredCause">所列范围内配置了代理变量，界面隐藏变量值。</sys:String>
    <sys:String x:Key="CheckProxyConfiguredSolution">向 IT 确认所需的代理和排除地址。保留组织批准的配置。</sys:String>
    <sys:String x:Key="CheckProxyUnsetTitle">未找到 Windows 代理环境变量</sys:String>
    <sys:String x:Key="CheckProxyUnsetCause">检查的环境变量未设置。Windows 或 Claude Code 中仍可能有代理设置。</sys:String>
    <sys:String x:Key="CheckProxyUnsetSolution">如果网络要求使用代理，请查看 Windows 代理设置和 Claude Code 的 /status。</sys:String>
    <sys:String x:Key="CheckNetReachableTitle">主机返回 HTTP 响应</sys:String>
    <sys:String x:Key="CheckNetReachableCause">主机回应了未附带认证信息的请求。登录和模型请求仍需单独确认。</sys:String>
    <sys:String x:Key="CheckNetReachableSolution">若 CLI 仍报错，请查看 /status 和实际请求的错误信息。</sys:String>
    <sys:String x:Key="CheckNetHttpWarningTitle">HTTP 响应需要关注</sys:String>
    <sys:String x:Key="CheckNetHttpWarningCause">响应可能涉及访问权限、代理、请求限额或服务状态。</sys:String>
    <sys:String x:Key="CheckNetHttpWarningSolution">查看 HTTP 状态码、批准的网络设置及 Claude 服务状态，然后重新检查。</sys:String>
    <sys:String x:Key="CheckNetDownloadReadyTitle">下载端点返回了版本号</sys:String>
    <sys:String x:Key="CheckNetDownloadReadyCause">公开端点返回了符合预期格式的发布版本。</sys:String>
    <sys:String x:Key="CheckNetDownloadReadySolution">继续安装或更新，完成后检查 CLI 版本。</sys:String>
    <sys:String x:Key="CheckNetDownloadForbiddenTitle">下载端点返回 HTTP 403</sys:String>
    <sys:String x:Key="CheckNetDownloadForbiddenCause">网络策略、代理、地区限制或服务策略可能拒绝了访问。</sys:String>
    <sys:String x:Key="CheckNetDownloadForbiddenSolution">确认所在地区受支持，并向 IT 确认是否允许访问 downloads.claude.ai。</sys:String>
    <sys:String x:Key="CheckNetDownloadHtmlTitle">下载端点返回网页</sys:String>
    <sys:String x:Key="CheckNetDownloadHtmlCause">版本请求收到 HTML。可能是网络登录页、代理或过滤器代为响应。</sys:String>
    <sys:String x:Key="CheckNetDownloadHtmlSolution">检查网络登录和代理设置，然后在获准的网络上重新检查。</sys:String>
    <sys:String x:Key="CheckNetDownloadUnexpectedTitle">下载响应与预期不符</sys:String>
    <sys:String x:Key="CheckNetDownloadUnexpectedCause">端点未返回预期格式的发布版本。</sys:String>
    <sys:String x:Key="CheckNetDownloadUnexpectedSolution">查看 HTTP 状态、批准的代理配置及 Claude 服务状态，然后重试。</sys:String>
    <sys:String x:Key="CheckNetRegionTitle">下载响应提示地区限制</sys:String>
    <sys:String x:Key="CheckNetRegionCause">响应表明当前地区无法使用此下载服务。</sys:String>
    <sys:String x:Key="CheckNetRegionSolution">确认 Anthropic 支持的地区以及当前网络所在地区。</sys:String>
    <sys:String x:Key="CheckNetTimeoutTitle">网络检查超时</sys:String>
    <sys:String x:Key="CheckNetTimeoutCause">请求未在显示的时限内完成。</sys:String>
    <sys:String x:Key="CheckNetTimeoutSolution">检查连接和批准的代理设置，然后重新检查。</sys:String>
    <sys:String x:Key="CheckNetTlsTitle">TLS 连接验证失败</sys:String>
    <sys:String x:Key="CheckNetTlsCause">Windows 无法与主机建立可信的 TLS 连接。</sys:String>
    <sys:String x:Key="CheckNetTlsSolution">向 IT 确认系统时间和公司 CA。Claude Code 可能还需要设置 NODE_EXTRA_CA_CERTS。</sys:String>
    <sys:String x:Key="CheckNetDnsTitle">无法解析主机名</sys:String>
    <sys:String x:Key="CheckNetDnsCause">网络未能将主机名解析为 IP 地址。</sys:String>
    <sys:String x:Key="CheckNetDnsSolution">检查 DNS、网络连接及获准的网络配置。</sys:String>
    <sys:String x:Key="CheckNetProxyTitle">代理连接失败</sys:String>
    <sys:String x:Key="CheckNetProxyCause">无法通过代理连接到主机。</sys:String>
    <sys:String x:Key="CheckNetProxySolution">向 IT 确认获准的代理和认证配置。</sys:String>
    <sys:String x:Key="CheckNetTransportTitle">网络请求失败</sys:String>
    <sys:String x:Key="CheckNetTransportCause">请求在取得可用于检查的响应之前结束。</sys:String>
    <sys:String x:Key="CheckNetTransportSolution">检查网络连接、防火墙及获准的代理，然后重新检查。</sys:String>
    <sys:String x:Key="FixUserRemoteSigned">将当前用户策略改为 RemoteSigned</sys:String>
    <sys:String x:Key="FixClearUserVariable">删除所列用户环境变量</sys:String>
    <sys:String x:Key="FixSetUserGitBash">将用户 Git Bash 路径设置为所示文件</sys:String>
</ResourceDictionary>
