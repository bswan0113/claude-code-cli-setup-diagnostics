<Window x:Class="ClaudeLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource AppTitle}" Width="960" Height="700" MinWidth="720" MinHeight="510"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        FontFamily="Segoe UI" FontSize="14" Foreground="#19243B" Background="#F1F4FA">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#19243B" />
        <SolidColorBrush x:Key="Muted" Color="#4C5B74" />
        <SolidColorBrush x:Key="Line" Color="#D8E0ED" />
        <SolidColorBrush x:Key="Accent" Color="#244BCC" />
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="22" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="21" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="BodyText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="22" />
        </Style>
        <Style x:Key="Action" TargetType="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="MinHeight" Value="39" />
            <Setter Property="Background" Value="#EDF2FF" />
            <Setter Property="Foreground" Value="#213C97" />
            <Setter Property="BorderBrush" Value="#D7E1FD" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.86" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#101B33" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryAction" TargetType="Button" BasedOn="{StaticResource Action}">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style x:Key="FolderAction" TargetType="Button" BasedOn="{StaticResource Action}">
            <Setter Property="Background" Value="#F6F8FC" />
            <Setter Property="BorderBrush" Value="#E6EBF4" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="12,9" />
        </Style>
        <Style x:Key="HistoryTab" TargetType="TabItem">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabSurface" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="#F0F4FC" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="#EDF2FF" />
                                <Setter Property="Foreground" Value="#213C97" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TabSurface" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#F1F4FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Background="#14223D" Padding="28,23,28,24">
            <DockPanel LastChildFill="True">
                <ComboBox x:Name="LanguagePicker" DockPanel.Dock="Right" Width="132" Margin="18,0,0,0" Padding="8,5"
                          VerticalAlignment="Center" AutomationProperties.Name="{DynamicResource LanguageLabel}"
                          SelectionChanged="LanguagePicker_SelectionChanged" SelectedValuePath="Tag">
                    <ComboBoxItem Tag="en" Content="English" />
                    <ComboBoxItem Tag="ko" Content="한국어" />
                    <ComboBoxItem Tag="zh-Hans" Content="简体中文" />
                    <ComboBoxItem Tag="ja" Content="日本語" />
                </ComboBox>
                <Border DockPanel.Dock="Left" Width="44" Height="44" Margin="0,0,14,0"
                        VerticalAlignment="Center" CornerRadius="11" Background="#283E69">
                    <Path Data="M 0,1 L 6,7 L 0,13 M 9,13 L 16,13" Width="18" Height="16" Stretch="Uniform"
                          Stroke="#DBE7FF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource AppTitle}" Foreground="White" FontSize="24" FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{DynamicResource AppSubtitle}" Foreground="#CAD8F5" Margin="0,3,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="26,23,26,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource OpenFolderTitle}" />
                    <TextBlock Grid.Row="1" Style="{StaticResource BodyText}" Margin="0,4,0,12"
                               Text="{DynamicResource OpenFolderBody}" />
                    <TextBox x:Name="FolderInput" Grid.Row="2" Padding="9,8" MinHeight="37" MaxLines="1"
                             VerticalContentAlignment="Center" BorderBrush="{StaticResource Line}"
                             AutomationProperties.Name="{DynamicResource FolderLabel}"
                             KeyDown="FolderInput_KeyDown" TextChanged="FolderInput_TextChanged" />
                    <WrapPanel Grid.Row="3" Margin="0,8,0,16" ItemHeight="45">
                        <Button x:Name="BrowseButton" Style="{StaticResource Action}" Margin="0,3,7,3"
                                Content="{DynamicResource BrowseFolder}" Click="Browse_Click" />
                        <Button x:Name="OpenButton" Style="{StaticResource PrimaryAction}" Margin="0,3,0,3"
                                Content="{DynamicResource OpenFolder}" Click="Open_Click" />
                    </WrapPanel>

                    <TabControl Grid.Row="4" BorderThickness="0" Padding="0" Background="Transparent">
                        <TabItem Header="{DynamicResource SessionsTitle}" Style="{StaticResource HistoryTab}">
                            <Grid Margin="0,9,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <WrapPanel x:Name="SessionScopePanel" Margin="0,0,0,5">
                                    <TextBlock x:Name="SessionScope" Style="{StaticResource BodyText}" VerticalAlignment="Center"
                                               Margin="0,0,8,0" />
                                    <Button x:Name="ShowAllSessionsButton" Style="{StaticResource Action}"
                                            MinHeight="28" Padding="8,3" Click="ShowAllSessions_Click" />
                                </WrapPanel>
                                <TextBlock x:Name="SessionNotice" Grid.Row="1" Style="{StaticResource BodyText}" VerticalAlignment="Top" />
                                <ListBox x:Name="SessionItems" Grid.Row="1" Padding="0" BorderThickness="0" Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.CanContentScroll="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Focusable" Value="False" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource FolderAction}" Margin="0,0,3,6" Tag="{Binding Session}"
                                                    AutomationProperties.Name="{Binding AccessibleName}"
                                                    Click="Session_Click">
                                                <Button.ToolTip>
                                                    <ToolTip MaxWidth="520"
                                                             DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Session.Title}" FontWeight="SemiBold"
                                                                       TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding Session.Cwd}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </ToolTip>
                                                </Button.ToolTip>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Session.Title}" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Session.Cwd}" Foreground="{StaticResource Muted}"
                                                               FontSize="12" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding ModifiedLocal}" Foreground="{StaticResource Muted}"
                                                               FontSize="12" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel x:Name="SessionFallbackPanel" Grid.Row="2" Margin="0,7,0,0">
                                    <TextBlock x:Name="SessionFallbackHint" Style="{StaticResource BodyText}" FontSize="12"
                                               Margin="0,0,0,4" />
                                    <ScrollViewer x:Name="FallbackFolderList" MaxHeight="100" Margin="0,0,0,4"
                                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                  Visibility="Collapsed">
                                        <ItemsControl x:Name="FallbackFolderItems">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource FolderAction}" Margin="0,0,3,4"
                                                            Tag="{Binding Path}" ToolTip="{Binding Path}"
                                                            AutomationProperties.Name="{Binding Path}" Click="FallbackFolder_Click">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Path}" Foreground="{StaticResource Muted}"
                                                                       FontSize="12" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <Button x:Name="SessionPickerButton" Style="{StaticResource Action}" HorizontalAlignment="Left"
                                            Click="SessionPicker_Click">
                                        <TextBlock Text="{DynamicResource SessionPicker}" TextWrapping="Wrap" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </TabItem>
                        <TabItem Header="{DynamicResource RecentTitle}" Style="{StaticResource HistoryTab}">
                            <Grid Margin="0,9,0,0">
                                <TextBlock x:Name="HistoryNotice" Style="{StaticResource BodyText}" VerticalAlignment="Top"
                                           Text="{DynamicResource HistoryLoading}" />
                                <ScrollViewer x:Name="RecentList" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                                    <ItemsControl x:Name="RecentItems">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource FolderAction}" Margin="0,0,3,6"
                                                        Tag="{Binding Path}" ToolTip="{Binding Path}"
                                                        AutomationProperties.Name="{Binding Path}" Click="RecentFolder_Click">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="30" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="15" />
                                                        </Grid.ColumnDefinitions>
                                                        <Path Data="M 1,2 L 6,2 L 8,4 L 16,4 L 16,13 L 1,13 Z"
                                                              Width="16" Height="13" Stretch="Uniform" Fill="#E2EAFF" Stroke="#3F65C7"
                                                              StrokeLineJoin="Round" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Path}" Foreground="{StaticResource Muted}"
                                                                       FontSize="12" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <Path Grid.Column="2" Data="M 2,2 L 7,7 L 2,12" Width="6" Height="11"
                                                              Stretch="Uniform" Stroke="#536581" StrokeThickness="1.6"
                                                              HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <ScrollViewer x:Name="SetupScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource SetupTitle}" />
                        <TextBlock Style="{StaticResource BodyText}" Text="{DynamicResource SetupBody}" Margin="0,4,0,13" />
                        <Button x:Name="DiagnoseButton" Style="{StaticResource Action}" HorizontalAlignment="Left"
                                MinWidth="112" Click="Diagnose_Click">
                            <TextBlock x:Name="DiagnoseLabel" TextWrapping="Wrap" />
                        </Button>
                        <Border x:Name="ResultCard" Visibility="Collapsed" Background="#F4F7FD" BorderBrush="#DCE5F5"
                                BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock x:Name="ResultTitle" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                                           AutomationProperties.LiveSetting="Polite" />
                                <TextBlock x:Name="ResultBody" Style="{StaticResource BodyText}" Margin="0,5,0,0" />
                                <StackPanel x:Name="ResultFolderPanel" Visibility="Collapsed" Margin="0,9,0,0">
                                    <TextBlock Text="{DynamicResource TargetFolder}" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock x:Name="ResultFolder" Style="{StaticResource BodyText}" FontSize="12" />
                                    <TextBlock x:Name="ResultIntent" Style="{StaticResource BodyText}" FontSize="12"
                                               Visibility="Collapsed" />
                                </StackPanel>
                                <StackPanel x:Name="ResultDetailPanel" Visibility="Collapsed" Margin="0,9,0,0">
                                    <TextBlock Text="{DynamicResource ResultDetailLabel}" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock x:Name="ResultDetail" Style="{StaticResource BodyText}" FontSize="12" />
                                </StackPanel>
                                <Button x:Name="RepairButton" Style="{StaticResource PrimaryAction}" HorizontalAlignment="Left"
                                        Margin="0,12,0,0" Visibility="Collapsed" Click="Repair_Click">
                                    <TextBlock x:Name="RepairLabel" TextWrapping="Wrap" />
                                </Button>
                                <WrapPanel x:Name="ResultActions" Margin="0,8,0,0" Visibility="Collapsed">
                                    <Button x:Name="LoginCommandButton" Style="{StaticResource Action}" Margin="0,4,6,0"
                                            Content="{DynamicResource CopyLoginCommand}" Click="LoginCommand_Click" />
                                    <Button Style="{StaticResource Action}" Margin="0,4,6,0"
                                            Content="{DynamicResource CopySummary}" Click="CopySummary_Click" />
                                    <Button x:Name="HelpButton" Style="{StaticResource Action}" Margin="0,4,0,0"
                                            Content="{DynamicResource OfficialHelp}" Click="Help_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border x:Name="StatusStrip" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0" Padding="12,8"
                    Background="#E7EDFA" CornerRadius="8" Visibility="Collapsed">
                <DockPanel>
                    <ProgressBar x:Name="ActivityIndicator" DockPanel.Dock="Left" IsIndeterminate="True"
                                 Width="38" Height="4" Margin="0,0,10,0" VerticalAlignment="Center"
                                 Foreground="{StaticResource Accent}" Visibility="Collapsed" />
                    <TextBlock x:Name="StatusText" Style="{StaticResource BodyText}"
                               AutomationProperties.LiveSetting="Polite" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
