<UserControl x:Class="ClaudeLauncher.AppearancePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.AutomationId="AppearancePanel" AutomationProperties.Name="{DynamicResource AppearanceTitle}"
             PreviewKeyDown="Panel_PreviewKeyDown" KeyboardNavigation.TabNavigation="Cycle">
    <UserControl.Resources>
        <ControlTemplate x:Key="TrackRail" TargetType="RepeatButton">
            <Border Height="4" VerticalAlignment="Center" Background="{TemplateBinding Background}" />
        </ControlTemplate>
        <Style x:Key="AppearanceRange" TargetType="Slider">
            <Setter Property="Focusable" Value="True" />
            <Setter Property="MinHeight" Value="29" />
            <Setter Property="TickFrequency" Value="5" />
            <Setter Property="SmallChange" Value="5" />
            <Setter Property="LargeChange" Value="5" />
            <Setter Property="IsSnapToTickEnabled" Value="True" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Border x:Name="Frame" BorderThickness="1" BorderBrush="Transparent" Background="Transparent" Padding="4,0">
                            <Track x:Name="PART_Track" Focusable="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Background="{DynamicResource Accent}" Template="{StaticResource TrackRail}" Focusable="False"
                                                  Command="Slider.DecreaseLarge" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="16" Height="21" Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{DynamicResource Primary}" BorderBrush="{DynamicResource FocusLine}"
                                                        BorderThickness="1" CornerRadius="3" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Background="{DynamicResource Line}" Template="{StaticResource TrackRail}" Focusable="False"
                                                  Command="Slider.IncreaseLarge" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource FocusLine}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AppearanceSwitch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Frame" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" Padding="4,4">
                            <DockPanel>
                                <Border x:Name="Box" DockPanel.Dock="Left" Width="18" Height="18" VerticalAlignment="Center"
                                        Margin="0,0,10,0" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                        Background="{DynamicResource FieldFill}">
                                    <Path x:Name="Tick" Margin="3" Data="M 0,4 L 3,7 L 8,0" Stretch="Uniform" StrokeThickness="2"
                                          Stroke="{DynamicResource PrimaryInk}" Visibility="Collapsed" />
                                </Border>
                                <ContentPresenter VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Primary}" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource FocusLine}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="22">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <DockPanel Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Style="{StaticResource LinkAction}" MinWidth="34"
                            Content="×" FontSize="{DynamicResource Font22}" Click="Close_Click"
                            AutomationProperties.Name="{DynamicResource CloseAppearance}" />
                    <TextBlock Style="{StaticResource SectionLabel}" Text="{DynamicResource AppearanceTitle}" VerticalAlignment="Center" />
                </DockPanel>
                <Border BorderBrush="{DynamicResource RowLine}" BorderThickness="0,1,0,0" Margin="0,0,0,11" />
                <CheckBox x:Name="DarkModeToggle" AutomationProperties.AutomationId="DarkModeToggle"
                          Style="{StaticResource AppearanceSwitch}" Content="{DynamicResource DarkModeLabel}"
                          Checked="Settings_Changed" Unchecked="Settings_Changed" Margin="0,0,0,13" />
                <DockPanel Margin="3,0,4,0">
                    <TextBlock x:Name="FontValue" DockPanel.Dock="Right" FontWeight="SemiBold" />
                    <TextBlock Text="{DynamicResource FontScaleLabel}" TextWrapping="Wrap" />
                </DockPanel>
                <Slider x:Name="FontScaleSlider" AutomationProperties.AutomationId="FontScaleSlider"
                        AutomationProperties.Name="{DynamicResource FontScaleLabel}" Style="{StaticResource AppearanceRange}"
                        Minimum="85" Maximum="125" ValueChanged="Settings_Changed" Margin="0,0,0,12" />
                <DockPanel Margin="3,0,4,0">
                    <TextBlock x:Name="OpacityValue" DockPanel.Dock="Right" FontWeight="SemiBold" />
                    <TextBlock Text="{DynamicResource OpacityLabel}" TextWrapping="Wrap" />
                </DockPanel>
                <Slider x:Name="OpacitySlider" AutomationProperties.AutomationId="OpacitySlider"
                        AutomationProperties.Name="{DynamicResource OpacityLabel}" Style="{StaticResource AppearanceRange}"
                        Minimum="60" Maximum="100" ValueChanged="Settings_Changed" />
                <TextBlock x:Name="SaveFeedback" Style="{StaticResource BodyText}" Text="{DynamicResource AppearanceSaveFailed}"
                           AutomationProperties.LiveSetting="Polite" Visibility="Collapsed" Margin="0,8,0,0" />
                <Button Style="{StaticResource Action}" HorizontalAlignment="Right" MinWidth="88" Margin="0,13,0,0"
                        Content="{DynamicResource DoneAppearance}" Click="Close_Click" />
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
