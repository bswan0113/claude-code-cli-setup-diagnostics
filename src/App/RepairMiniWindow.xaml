<Window x:Class="ClaudeLauncher.RepairMiniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude Code · Mini" Width="680" Height="720"
        MinWidth="360" MinHeight="320" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Canvas}" Foreground="{DynamicResource Ink}"
        FontFamily="Segoe UI" FontSize="{DynamicResource Font16}" UseLayoutRounding="True"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
            <Label Content="{DynamicResource LanguageLabel}" Target="{Binding ElementName=LanguagePicker}"
                   VerticalAlignment="Center" Foreground="{DynamicResource Ink}" />
            <ComboBox x:Name="LanguagePicker" SelectedValuePath="Tag" MinWidth="128" Padding="6,4"
                      AutomationProperties.Name="{DynamicResource LanguageLabel}" SelectionChanged="LanguageChanged">
                <ComboBoxItem Tag="en" Content="English" />
                <ComboBoxItem Tag="ko" Content="한국어" />
                <ComboBoxItem Tag="zh-Hans" Content="简体中文" />
                <ComboBoxItem Tag="ja" Content="日本語" />
            </ComboBox>
        </StackPanel>
        <ContentControl x:Name="RepairHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    </DockPanel>
</Window>
