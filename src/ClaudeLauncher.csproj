<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ClaudeLauncher</RootNamespace>
    <AssemblyName>ClaudeLauncher</AssemblyName>
    <Product>Claude Code CLI Setup &amp; Diagnostics</Product>
    <Version>0.5.0</Version>
    <ApplicationIcon>Launcher.ico</ApplicationIcon>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Edition)' == 'Mini'">
    <AssemblyName>ClaudeRepairMini</AssemblyName>
    <Product>Claude Code Setup and Repair Mini</Product>
    <DefineConstants>$(DefineConstants);REPAIR_MINI</DefineConstants>
    <EnableCompressionInSingleFile Condition="'$(PublishSingleFile)' == 'true' Or '$(PublishProfile)' == 'Windows-x64'">true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup Condition="'$(Edition)' == 'Mini'">
    <Compile Remove="App/MainWindow*.cs;App/AppearancePanel.xaml.cs;App/DesktopSidebar.cs;App/LauncherRows.cs;App/UsageText.cs;App/SessionOwnerProfiles.cs;Launcher/LiveTerminal.cs;Launcher/TerminalLauncher.cs;History/*.cs" />
    <Compile Include="History/ProfileDataPaths.cs" />
    <Page Remove="App/MainWindow.xaml;App/AppearancePanel.xaml" />
  </ItemGroup>
  <ItemGroup Condition="'$(Edition)' != 'Mini'">
    <Compile Remove="App/RepairMiniWindow.xaml.cs" />
    <Page Remove="App/RepairMiniWindow.xaml" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="System.IO" />
    <!-- Keep the language dictionaries verbatim in the app's WPF resources. A language edit
         then goes straight into the assembly without relying on cached BAML from a prior build. -->
    <Page Remove="App/Resources/*.en.xaml;App/Resources/*.ko.xaml;App/Resources/*.ja.xaml;App/Resources/*.zh-Hans.xaml" />
    <Resource Include="App/Resources/*.en.xaml;App/Resources/*.ko.xaml;App/Resources/*.ja.xaml;App/Resources/*.zh-Hans.xaml" />
    <Page Remove="App/App.xaml" />
    <ApplicationDefinition Include="App/App.xaml" />
  </ItemGroup>
</Project>
