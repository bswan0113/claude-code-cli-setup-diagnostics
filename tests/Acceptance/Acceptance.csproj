<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <!-- The hidden STA fixture hosts the launcher's application-scoped pack URIs in this test assembly. -->
    <Page Include="../../src/App/Resources/*.xaml" Link="App/Resources/%(Filename)%(Extension)" />
    <ProjectReference Include="../../src/ClaudeLauncher.csproj" />
    <ProjectReference Include="../SettingsIsolationHook/SettingsIsolationHook.csproj" />
    <ProjectReference Include="../UnsignedCli/UnsignedCli.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyUnsignedCli" AfterTargets="Build">
    <MSBuild Projects="../UnsignedCli/UnsignedCli.csproj" Targets="GetTargetPath"
             Properties="Configuration=$(Configuration);TargetFramework=net10.0">
      <Output TaskParameter="TargetOutputs" ItemName="UnsignedFixtureAssembly" />
    </MSBuild>
    <PropertyGroup>
      <UnsignedFixtureDirectory>@(UnsignedFixtureAssembly->'%(RootDir)%(Directory)')</UnsignedFixtureDirectory>
    </PropertyGroup>
    <ItemGroup>
      <FixtureOutput Include="$(UnsignedFixtureDirectory)claude.*" />
    </ItemGroup>
    <Copy SourceFiles="@(FixtureOutput)" DestinationFolder="$(OutDir)unsigned-cli" />
  </Target>
</Project>
