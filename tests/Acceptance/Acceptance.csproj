<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/ClaudeLauncher.csproj" />
    <ProjectReference Include="../UnsignedCli/UnsignedCli.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyUnsignedCli" AfterTargets="Build">
    <ItemGroup>
      <FixtureOutput Include="../UnsignedCli/bin/$(Configuration)/net10.0/claude.*" />
    </ItemGroup>
    <Copy SourceFiles="@(FixtureOutput)" DestinationFolder="$(OutDir)unsigned-cli" />
  </Target>
</Project>
